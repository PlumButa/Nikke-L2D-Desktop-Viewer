{
  "id": "426001",
  "resourceId": 260,
  "name": "神罰",
  "skin": "初次的愛戀",
  "spineVersion": "4.0",
  "skel": "c260_01_00.skel",
  "atlas": "c260_01_00.atlas",
  "defaultAnimation": "idle",
  "interactions": [
    {
      "id": "voice_01",
      "category": "在大廳點擊時I",
      "audio": "voices/voice_01.mp3",
      "text": "指揮官！我會保護您的！",
      "animation": "action"
    },
    {
      "id": "voice_02",
      "category": "在大廳點擊時I",
      "audio": "voices/voice_02.mp3",
      "text": "指揮官，您怎麼會穿這麼大的衣服啊？",
      "animation": "action"
    },
    {
      "id": "voice_03",
      "category": "在大廳點擊時I",
      "audio": "voices/voice_03.mp3",
      "text": "我一定會保護你的。",
      "animation": "action"
    },
    {
      "id": "voice_04",
      "category": "在大廳點擊時II",
      "audio": "voices/voice_04.mp3",
      "text": "我喜歡指揮官，我還喜歡拉毗、喜歡阿妮斯、喜歡尼恩！",
      "animation": "action"
    },
    {
      "id": "voice_05",
      "category": "在大廳點擊時II",
      "audio": "voices/voice_05.mp3",
      "text": "哇～袖子好長啊！好像繃帶一樣！",
      "animation": "action"
    },
    {
      "id": "voice_06",
      "category": "在大廳點擊時II",
      "audio": "voices/voice_06.mp3",
      "text": "這個繃帶我會珍藏一輩子。\n因為它是我最珍貴的寶物。",
      "animation": "action"
    },
    {
      "id": "voice_07",
      "category": "在大廳點擊時III",
      "audio": "voices/voice_07.mp3",
      "text": "我喜歡繃帶，它讓我的內心充滿溫暖。",
      "animation": "action"
    },
    {
      "id": "voice_08",
      "category": "在大廳點擊時III",
      "audio": "voices/voice_08.mp3",
      "text": "這個娃娃就是指揮官！\n我是絕對不會把它弄丟的！",
      "animation": "action"
    },
    {
      "id": "voice_09",
      "category": "在大廳點擊時III",
      "audio": "voices/voice_09.mp3",
      "text": "大家都過得不錯吧？",
      "animation": "action"
    },
    {
      "id": "voice_10",
      "category": "在大廳點擊時（好感度10）I",
      "audio": "voices/voice_10.mp3",
      "text": "我喜歡指揮官。比拉毗、阿妮斯和尼恩對您的喜愛都更勝一籌！",
      "animation": "action"
    },
    {
      "id": "voice_11",
      "category": "在大廳點擊時（好感度10）I",
      "audio": "voices/voice_11.mp3",
      "text": "嗅嗅！嘿嘿，是指揮官的味道～",
      "animation": "action"
    },
    {
      "id": "voice_12",
      "category": "在大廳點擊時（好感度10）I",
      "audio": "voices/voice_12.mp3",
      "text": "要珍惜的東西越來越多了。\n……因此現在就由我來保護大家吧。",
      "animation": "action"
    },
    {
      "id": "voice_13",
      "category": "在大廳點擊時（好感度10）II",
      "audio": "voices/voice_13.mp3",
      "text": "我特別珍惜指揮官給我的繃帶。\n我不會把它交給任何人。",
      "animation": "action"
    },
    {
      "id": "voice_14",
      "category": "在大廳點擊時（好感度10）II",
      "audio": "voices/voice_14.mp3",
      "text": "如果我能緊緊抱著指揮官睡覺的話，一定馬上就能入睡。",
      "animation": "action"
    },
    {
      "id": "voice_15",
      "category": "在大廳點擊時（好感度10）II",
      "audio": "voices/voice_15.mp3",
      "text": "我好像知道我是誰了。\n我受到了很多人的幫助。",
      "animation": "action"
    },
    {
      "id": "voice_16",
      "category": "在大廳點擊時（好感度10）III",
      "audio": "voices/voice_16.mp3",
      "text": "我好幸福，指揮官。\n我非常非常幸福！",
      "animation": "action"
    },
    {
      "id": "voice_17",
      "category": "在大廳點擊時（好感度10）III",
      "audio": "voices/voice_17.mp3",
      "text": "穿著這件衣服，感覺就像被指揮官抱在懷裡一樣。",
      "animation": "action"
    },
    {
      "id": "voice_18",
      "category": "在大廳點擊時（好感度10）III",
      "audio": "voices/voice_18.mp3",
      "text": "真想快點讓大家看看我的樣子。\n一定都會稱讚我吧？",
      "animation": "action"
    },
    {
      "id": "voice_19",
      "category": "在大廳閒置時",
      "audio": "voices/voice_19.mp3",
      "text": "指揮官，您在玩比誰先眨眼的遊戲嗎？",
      "animation": "action"
    },
    {
      "id": "voice_20",
      "category": "在大廳閒置時",
      "audio": "voices/voice_20.mp3",
      "text": "指揮官？您去哪裡了？\n我可以試試別的衣服嗎？",
      "animation": "action"
    },
    {
      "id": "voice_21",
      "category": "在大廳閒置時",
      "audio": "voices/voice_21.mp3",
      "text": "我沒關係。\n我已經習慣了等待。",
      "animation": "action"
    },
    {
      "id": "voice_22",
      "category": "在大廳閒置時（好感度10）I",
      "audio": "voices/voice_22.mp3",
      "text": "我喜歡這樣靜靜地待在您身邊。\n嘿嘿，可以一直看著指揮官，\n真好！",
      "animation": "delight"
    },
    {
      "id": "voice_23",
      "category": "在大廳閒置時（好感度10）I",
      "audio": "voices/voice_23.mp3",
      "text": "嗯……指揮官，您去哪裡了？\n這釦子要怎麼扣上啊？",
      "animation": "delight"
    },
    {
      "id": "voice_24",
      "category": "在大廳閒置時（好感度10）I",
      "audio": "voices/voice_24.mp3",
      "text": "我可以一直等下去。\n……因為我不再孤單了。",
      "animation": "delight"
    },
    {
      "id": "voice_25",
      "category": "在前哨基地點擊I",
      "audio": "voices/voice_25.mp3",
      "text": "這裡就和指揮官一樣，好溫暖。",
      "animation": "action"
    },
    {
      "id": "voice_26",
      "category": "在前哨基地點擊I",
      "audio": "voices/voice_26.mp3",
      "text": "阿妮斯說看到我還以為看到鬼了！\n……可是，鬼是什麼啊？",
      "animation": "action"
    },
    {
      "id": "voice_27",
      "category": "在前哨基地點擊I",
      "audio": "voices/voice_27.mp3",
      "text": "我仍然很想念那個地方。",
      "animation": "action"
    },
    {
      "id": "voice_28",
      "category": "在前哨基地點擊II",
      "audio": "voices/voice_28.mp3",
      "text": "阿妮斯說要在宿舍裡玩麵粉，叫我出去。",
      "animation": "action"
    },
    {
      "id": "voice_29",
      "category": "在前哨基地點擊II",
      "audio": "voices/voice_29.mp3",
      "text": "我和指揮官一起在散步呢！",
      "animation": "action"
    },
    {
      "id": "voice_30",
      "category": "在前哨基地點擊II",
      "audio": "voices/voice_30.mp3",
      "text": "這裡也是我要守護的地方。",
      "animation": "action"
    },
    {
      "id": "voice_31",
      "category": "在前哨基地點擊III",
      "audio": "voices/voice_31.mp3",
      "text": "指揮官！一起散……？絲安……撒……什麼來著？\n對了！撒布吧？",
      "animation": "action"
    },
    {
      "id": "voice_32",
      "category": "在前哨基地點擊III",
      "audio": "voices/voice_32.mp3",
      "text": "指揮官！阿妮斯在冰箱裡塞滿了蘇打水！\n我們去把冰箱掏空吧！",
      "animation": "action"
    },
    {
      "id": "voice_33",
      "category": "在前哨基地點擊III",
      "audio": "voices/voice_33.mp3",
      "text": "這讓我想起了和大家在一起度過的時光。\n那時候真的很開心。",
      "animation": "action"
    },
    {
      "id": "voice_34",
      "category": "初次見面",
      "audio": "voices/voice_34.mp3",
      "text": "指揮官，我要保護您，一定會保護您的。",
      "animation": "idle"
    },
    {
      "id": "voice_35",
      "category": "初次見面",
      "audio": "voices/voice_35.mp3",
      "text": "指揮官的衣服上有指揮官的味道！我好喜歡啊！",
      "animation": "idle"
    },
    {
      "id": "voice_36",
      "category": "初次見面",
      "audio": "voices/voice_36.mp3",
      "text": "我不會再哭了。\n我會保護好大家。",
      "animation": "idle"
    },
    {
      "id": "voice_37",
      "category": "戰鬥力提升I",
      "audio": "voices/voice_37.mp3",
      "text": "好神奇啊！",
      "animation": "idle"
    },
    {
      "id": "voice_38",
      "category": "戰鬥力提升I",
      "audio": "voices/voice_38.mp3",
      "text": "我現在可以再穿一件衣服了嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_39",
      "category": "戰鬥力提升I",
      "audio": "voices/voice_39.mp3",
      "text": "多虧了你，我才能繼續堅持下去。",
      "animation": "idle"
    },
    {
      "id": "voice_40",
      "category": "戰鬥力提升II",
      "audio": "voices/voice_40.mp3",
      "text": "指揮官！我更厲害了。",
      "animation": "idle"
    },
    {
      "id": "voice_41",
      "category": "戰鬥力提升II",
      "audio": "voices/voice_41.mp3",
      "text": "我變強壯了！",
      "animation": "idle"
    },
    {
      "id": "voice_42",
      "category": "戰鬥力提升II",
      "audio": "voices/voice_42.mp3",
      "text": "我不會讓你失望的。",
      "animation": "idle"
    },
    {
      "id": "voice_43",
      "category": "戰鬥力提升III",
      "audio": "voices/voice_43.mp3",
      "text": "我更能把您保護好了。",
      "animation": "idle"
    },
    {
      "id": "voice_44",
      "category": "戰鬥力提升III",
      "audio": "voices/voice_44.mp3",
      "text": "哇，我突然充滿力量了！",
      "animation": "idle"
    },
    {
      "id": "voice_45",
      "category": "戰鬥力提升III",
      "audio": "voices/voice_45.mp3",
      "text": "嗯。的確變強了。",
      "animation": "idle"
    },
    {
      "id": "voice_46",
      "category": "禮物I",
      "audio": "voices/voice_46.mp3",
      "text": "這個和繃帶一樣吧！",
      "animation": "idle"
    },
    {
      "id": "voice_47",
      "category": "禮物I",
      "audio": "voices/voice_47.mp3",
      "text": "這也是可以穿在身上的嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_48",
      "category": "禮物I",
      "audio": "voices/voice_48.mp3",
      "text": "真是令人懷念的東西啊。",
      "animation": "idle"
    },
    {
      "id": "voice_49",
      "category": "禮物II",
      "audio": "voices/voice_49.mp3",
      "text": "我好喜歡指揮官！",
      "animation": "idle"
    },
    {
      "id": "voice_50",
      "category": "禮物II",
      "audio": "voices/voice_50.mp3",
      "text": "哇，這裡也散發著指揮官的味道！",
      "animation": "idle"
    },
    {
      "id": "voice_51",
      "category": "禮物II",
      "audio": "voices/voice_51.mp3",
      "text": "我會好好珍藏的。",
      "animation": "idle"
    },
    {
      "id": "voice_52",
      "category": "禮物III",
      "audio": "voices/voice_52.mp3",
      "text": "收到禮物之後，內心更溫暖了。",
      "animation": "idle"
    },
    {
      "id": "voice_53",
      "category": "禮物III",
      "audio": "voices/voice_53.mp3",
      "text": "他們說，這種時候應該說「謝謝」！謝謝！",
      "animation": "idle"
    },
    {
      "id": "voice_54",
      "category": "禮物III",
      "audio": "voices/voice_54.mp3",
      "text": "大家也常送我充滿心意的禮物。\n……謝謝。",
      "animation": "idle"
    },
    {
      "id": "voice_55",
      "category": "好感度提升I",
      "audio": "voices/voice_55.mp3",
      "text": "指揮官，我好想您，每一天都好想您。",
      "animation": "delight"
    },
    {
      "id": "voice_56",
      "category": "好感度提升I",
      "audio": "voices/voice_56.mp3",
      "text": "我喜歡指揮官！比麵粉更喜歡！",
      "animation": "delight"
    },
    {
      "id": "voice_57",
      "category": "好感度提升I",
      "audio": "voices/voice_57.mp3",
      "text": "這溫暖了我的心。",
      "animation": "delight"
    },
    {
      "id": "voice_58",
      "category": "好感度提升II",
      "audio": "voices/voice_58.mp3",
      "text": "和指揮官在一起，心裡感覺很暖和。",
      "animation": "delight"
    },
    {
      "id": "voice_59",
      "category": "好感度提升II",
      "audio": "voices/voice_59.mp3",
      "text": "指揮官！我喜歡您！我對您的喜歡就像這件衣服一樣大！",
      "animation": "delight"
    },
    {
      "id": "voice_60",
      "category": "好感度提升II",
      "audio": "voices/voice_60.mp3",
      "text": "我好想你。\n……真的好想你。",
      "animation": "delight"
    },
    {
      "id": "voice_61",
      "category": "好感度提升III",
      "audio": "voices/voice_61.mp3",
      "text": "我喜歡您。指揮官，我非常非常喜歡您。",
      "animation": "delight"
    },
    {
      "id": "voice_62",
      "category": "好感度提升III",
      "audio": "voices/voice_62.mp3",
      "text": "我心裡滿滿都是指揮官！",
      "animation": "delight"
    },
    {
      "id": "voice_63",
      "category": "好感度提升III",
      "audio": "voices/voice_63.mp3",
      "text": "……怎麼會越來越喜歡了呢？\n太神奇了。",
      "animation": "delight"
    },
    {
      "id": "voice_64",
      "category": "編隊",
      "audio": "voices/voice_64.mp3",
      "text": "我會保護好指揮官的！",
      "animation": "idle"
    },
    {
      "id": "voice_65",
      "category": "編隊",
      "audio": "voices/voice_65.mp3",
      "text": "我可以把指揮官的衣服穿走嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_66",
      "category": "編隊",
      "audio": "voices/voice_66.mp3",
      "text": "我隨時都準備好了。",
      "animation": "idle"
    },
    {
      "id": "voice_67",
      "category": "在野外點擊部隊",
      "audio": "voices/voice_67.mp3",
      "text": "是！指揮官！",
      "animation": "idle"
    },
    {
      "id": "voice_68",
      "category": "在野外點擊部隊",
      "audio": "voices/voice_68.mp3",
      "text": "是！指揮官！",
      "animation": "idle"
    },
    {
      "id": "voice_69",
      "category": "在野外點擊部隊",
      "audio": "voices/voice_69.mp3",
      "text": "是，您請說。",
      "animation": "idle"
    },
    {
      "id": "voice_70",
      "category": "在野外移動部隊",
      "audio": "voices/voice_70.mp3",
      "text": "要去那裡嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_71",
      "category": "在野外移動部隊",
      "audio": "voices/voice_71.mp3",
      "text": "是這邊嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_72",
      "category": "在野外移動部隊",
      "audio": "voices/voice_72.mp3",
      "text": "準備出發。",
      "animation": "idle"
    },
    {
      "id": "voice_73",
      "category": "進入戰鬥",
      "audio": "voices/voice_73.mp3",
      "text": "削弱！",
      "animation": "idle"
    },
    {
      "id": "voice_74",
      "category": "進入戰鬥",
      "audio": "voices/voice_74.mp3",
      "text": "Scout!",
      "animation": "idle"
    },
    {
      "id": "voice_75",
      "category": "進入戰鬥",
      "audio": "voices/voice_75.mp3",
      "text": "遇敵！",
      "animation": "idle"
    },
    {
      "id": "voice_76",
      "category": "開始戰鬥I",
      "audio": "voices/voice_76.mp3",
      "text": "我會保護指揮官的！",
      "animation": "idle"
    },
    {
      "id": "voice_77",
      "category": "開始戰鬥I",
      "audio": "voices/voice_77.mp3",
      "text": "衣服不能弄髒！",
      "animation": "idle"
    },
    {
      "id": "voice_78",
      "category": "開始戰鬥I",
      "audio": "voices/voice_78.mp3",
      "text": "看來得一決高下了。",
      "animation": "idle"
    },
    {
      "id": "voice_79",
      "category": "開始戰鬥II",
      "audio": "voices/voice_79.mp3",
      "text": "可以攻擊了嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_80",
      "category": "開始戰鬥II",
      "audio": "voices/voice_80.mp3",
      "text": "我來保護您！",
      "animation": "idle"
    },
    {
      "id": "voice_81",
      "category": "開始戰鬥II",
      "audio": "voices/voice_81.mp3",
      "text": "我會讓你死得痛快的。",
      "animation": "idle"
    },
    {
      "id": "voice_82",
      "category": "開始戰鬥III",
      "audio": "voices/voice_82.mp3",
      "text": "指揮官陷入危險了嗎？那我當然要出戰。",
      "animation": "idle"
    },
    {
      "id": "voice_83",
      "category": "開始戰鬥III",
      "audio": "voices/voice_83.mp3",
      "text": "指揮官，請小心！",
      "animation": "idle"
    },
    {
      "id": "voice_84",
      "category": "開始戰鬥III",
      "audio": "voices/voice_84.mp3",
      "text": "……我會把你們全都送回去。",
      "animation": "idle"
    },
    {
      "id": "voice_85",
      "category": "換彈I",
      "audio": "voices/voice_85.mp3",
      "text": "重……新……裝……填！",
      "animation": "idle"
    },
    {
      "id": "voice_86",
      "category": "換彈I",
      "audio": "voices/voice_86.mp3",
      "text": "指揮官～我來餵您吃飯！",
      "animation": "idle"
    },
    {
      "id": "voice_87",
      "category": "換彈I",
      "audio": "voices/voice_87.mp3",
      "text": "我還可以繼續戰鬥。",
      "animation": "idle"
    },
    {
      "id": "voice_88",
