{
  "id": "209101",
  "resourceId": 91,
  "name": "貝斯蒂",
  "skin": "方舟魔法師",
  "spineVersion": "4.1",
  "skel": "c091_01_00.skel",
  "atlas": "c091_01_00.atlas",
  "defaultAnimation": "idle",
  "interactions": [
    {
      "id": "voice_01",
      "category": "在大廳點擊時I",
      "audio": "voices/voice_01.mp3",
      "text": "你，是在教我怎麼交朋友嗎？",
      "animation": "action"
    },
    {
      "id": "voice_02",
      "category": "在大廳點擊時I",
      "audio": "voices/voice_02.mp3",
      "text": "我、我們什麼時候要去冒險？",
      "animation": "action"
    },
    {
      "id": "voice_03",
      "category": "在大廳點擊時II",
      "audio": "voices/voice_03.mp3",
      "text": "我擅長什麼？嗯……殺戮？",
      "animation": "action"
    },
    {
      "id": "voice_04",
      "category": "在大廳點擊時II",
      "audio": "voices/voice_04.mp3",
      "text": "你問我有沒有打算學其他魔法？\n但除了爆炸的魔法，\n其他的都沒有意義啊……",
      "animation": "action"
    },
    {
      "id": "voice_05",
      "category": "在大廳點擊時III",
      "audio": "voices/voice_05.mp3",
      "text": "……不准嘲笑我是愛哭鬼，就算是指揮官大人也不行。",
      "animation": "action"
    },
    {
      "id": "voice_06",
      "category": "在大廳點擊時III",
      "audio": "voices/voice_06.mp3",
      "text": "魔、魔法棒？\n我不是拿在手上了嗎……？",
      "animation": "action"
    },
    {
      "id": "voice_07",
      "category": "在大廳點擊時（好感度10）I",
      "audio": "voices/voice_07.mp3",
      "text": "指、指揮官大人。你還記得我的日記內容嗎？",
      "animation": "action"
    },
    {
      "id": "voice_08",
      "category": "在大廳點擊時（好感度10）I",
      "audio": "voices/voice_08.mp3",
      "text": "爆炸就是夢想！",
      "animation": "action"
    },
    {
      "id": "voice_09",
      "category": "在大廳點擊時（好感度10）II",
      "audio": "voices/voice_09.mp3",
      "text": "最近……整天都在笑……我、我是怎麼了？",
      "animation": "action"
    },
    {
      "id": "voice_10",
      "category": "在大廳點擊時（好感度10）II",
      "audio": "voices/voice_10.mp3",
      "text": "我可愛的法杖，它的名字叫貓咪。\n鎧甲騎士大人要不要和貓咪當朋友？",
      "animation": "action"
    },
    {
      "id": "voice_11",
      "category": "在大廳點擊時（好感度10）III",
      "audio": "voices/voice_11.mp3",
      "text": "能、能再陪我去看電影嗎？",
      "animation": "action"
    },
    {
      "id": "voice_12",
      "category": "在大廳點擊時（好感度10）III",
      "audio": "voices/voice_12.mp3",
      "text": "爆炸這方面，\n我有自信不會輸給任何人……！",
      "animation": "action"
    },
    {
      "id": "voice_13",
      "category": "在大廳閒置時",
      "audio": "voices/voice_13.mp3",
      "text": "指、指揮官……指揮官大人？",
      "animation": "action"
    },
    {
      "id": "voice_14",
      "category": "在大廳閒置時",
      "audio": "voices/voice_14.mp3",
      "text": "大、大家都去哪裡了啊……？\n我們不是組隊了嗎……？",
      "animation": "action"
    },
    {
      "id": "voice_15",
      "category": "在大廳閒置時（好感度10）I",
      "audio": "voices/voice_15.mp3",
      "text": "指揮官大人太壞了……居、居然把我丟下就不見了……",
      "animation": "shy"
    },
    {
      "id": "voice_16",
      "category": "在大廳閒置時（好感度10）I",
      "audio": "voices/voice_16.mp3",
      "text": "我還想引爆一遍這個地方……\n不、不如現在就引爆……？\n墮入邊界彼方的真理啊，\n化作此處的扭曲……",
      "animation": "shy"
    },
    {
      "id": "voice_17",
      "category": "在前哨基地點擊I",
      "audio": "voices/voice_17.mp3",
      "text": "你知道嗎？軍火庫流傳著可怕的傳說。",
      "animation": "action"
    },
    {
      "id": "voice_18",
      "category": "在前哨基地點擊I",
      "audio": "voices/voice_18.mp3",
      "text": "請、請問……我可以炸掉那棟建築嗎……？",
      "animation": "action"
    },
    {
      "id": "voice_19",
      "category": "在前哨基地點擊II",
      "audio": "voices/voice_19.mp3",
      "text": "……致可愛的日記本：貓咪。\n今、今天我和指揮官大人說的話，超過了一句！我很棒吧。",
      "animation": "action"
    },
    {
      "id": "voice_20",
      "category": "在前哨基地點擊II",
      "audio": "voices/voice_20.mp3",
      "text": "任、任務要去哪裡接？",
      "animation": "action"
    },
    {
      "id": "voice_21",
      "category": "在前哨基地點擊III",
      "audio": "voices/voice_21.mp3",
      "text": "每天，我都想像用不同的方式殺死那些欺負我的人……然後心情就會變得平和下來。",
      "animation": "action"
    },
    {
      "id": "voice_22",
      "category": "在前哨基地點擊III",
      "audio": "voices/voice_22.mp3",
      "text": "我、我每天早上都會使用爆炸魔法。\n……這樣能讓我的內心變得平靜。",
      "animation": "action"
    },
    {
      "id": "voice_23",
      "category": "初次見面",
      "audio": "voices/voice_23.mp3",
      "text": "別、別欺負我……\n我也不知道我會做出什麼事情來。",
      "animation": "idle"
    },
    {
      "id": "voice_24",
      "category": "初次見面",
      "audio": "voices/voice_24.mp3",
      "text": "我、我是碧眼的小夜叉……貝斯蒂……",
      "animation": "idle"
    },
    {
      "id": "voice_25",
      "category": "戰鬥力提升I",
      "audio": "voices/voice_25.mp3",
      "text": "感、感謝你的援助！",
      "animation": "idle"
    },
    {
      "id": "voice_26",
      "category": "戰鬥力提升I",
      "audio": "voices/voice_26.mp3",
      "text": "這、這下我能做更高等級的任務了……",
      "animation": "idle"
    },
    {
      "id": "voice_27",
      "category": "戰鬥力提升II",
      "audio": "voices/voice_27.mp3",
      "text": "……我好像變強了。",
      "animation": "idle"
    },
    {
      "id": "voice_28",
      "category": "戰鬥力提升II",
      "audio": "voices/voice_28.mp3",
      "text": "我、我會更加努力，讓你見識最厲害的爆炸。",
      "animation": "idle"
    },
    {
      "id": "voice_29",
      "category": "戰鬥力提升III",
      "audio": "voices/voice_29.mp3",
      "text": "以後殺戮更容易了吧？",
      "animation": "idle"
    },
    {
      "id": "voice_30",
      "category": "戰鬥力提升III",
      "audio": "voices/voice_30.mp3",
      "text": "這下爆炸起來肯定會更加華麗！",
      "animation": "idle"
    },
    {
      "id": "voice_31",
      "category": "禮物I",
      "audio": "voices/voice_31.mp3",
      "text": "是、是給我的嗎？真的嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_32",
      "category": "禮物I",
      "audio": "voices/voice_32.mp3",
      "text": "原來除了爆炸，還有其他好東西啊！",
      "animation": "idle"
    },
    {
      "id": "voice_33",
      "category": "禮物II",
      "audio": "voices/voice_33.mp3",
      "text": "……開心。",
      "animation": "idle"
    },
    {
      "id": "voice_34",
      "category": "禮物II",
      "audio": "voices/voice_34.mp3",
      "text": "嘿、嘿嘿。",
      "animation": "idle"
    },
    {
      "id": "voice_35",
      "category": "禮物III",
      "audio": "voices/voice_35.mp3",
      "text": "原來好朋友之間還可以互贈物品啊……",
      "animation": "idle"
    },
    {
      "id": "voice_36",
      "category": "禮物III",
      "audio": "voices/voice_36.mp3",
      "text": "既、既然你送了我這個，\n那我們現在就是朋友了吧？\n還是說，比朋友更進一步……？\n我們算是什麼關係呢？",
      "animation": "idle"
    },
    {
      "id": "voice_37",
      "category": "好感度提升I",
      "audio": "voices/voice_37.mp3",
      "text": "那，我們現在是好朋友了嗎？\n不，其實我……還想要更親密的關係。",
      "animation": "shy"
    },
    {
      "id": "voice_38",
      "category": "好感度提升I",
      "audio": "voices/voice_38.mp3",
      "text": "我、我感覺我的心快要爆炸了……",
      "animation": "shy"
    },
    {
      "id": "voice_39",
      "category": "好感度提升II",
      "audio": "voices/voice_39.mp3",
      "text": "怎麼辦……不管見多少次，還是想見你。",
      "animation": "shy"
    },
    {
      "id": "voice_40",
      "category": "好感度提升II",
      "audio": "voices/voice_40.mp3",
      "text": "我對鎧甲騎士大人的感情越來越深厚了……",
      "animation": "shy"
    },
    {
      "id": "voice_41",
      "category": "好感度提升III",
      "audio": "voices/voice_41.mp3",
      "text": "這個……就是喜歡嗎……？",
      "animation": "shy"
    },
    {
      "id": "voice_42",
      "category": "好感度提升III",
      "audio": "voices/voice_42.mp3",
      "text": "以、以後我只認這支隊伍。\n嗯，就這麼決定了。",
      "animation": "shy"
    },
    {
      "id": "voice_43",
      "category": "編隊",
      "audio": "voices/voice_43.mp3",
      "text": "交、交給我吧！",
      "animation": "idle"
    },
    {
      "id": "voice_44",
      "category": "編隊",
      "audio": "voices/voice_44.mp3",
      "text": "你、你要和我組隊嗎……？",
      "animation": "idle"
    },
    {
      "id": "voice_45",
      "category": "在野外點擊部隊",
      "audio": "voices/voice_45.mp3",
      "text": "……嗯，我在聽。",
      "animation": "idle"
    },
    {
      "id": "voice_46",
      "category": "在野外點擊部隊",
      "audio": "voices/voice_46.mp3",
      "text": "……嗯，下達命令吧。",
      "animation": "idle"
    },
    {
      "id": "voice_47",
      "category": "在野外移動部隊",
      "audio": "voices/voice_47.mp3",
      "text": "正、正在前往。",
      "animation": "idle"
    },
    {
      "id": "voice_48",
      "category": "在野外移動部隊",
      "audio": "voices/voice_48.mp3",
      "text": "這、這邊嗎……？",
      "animation": "idle"
    },
    {
      "id": "voice_49",
      "category": "進入戰鬥",
      "audio": "voices/voice_49.mp3",
      "text": "戰鬥，要開始了。",
      "animation": "idle"
    },
    {
      "id": "voice_50",
      "category": "進入戰鬥",
      "audio": "voices/voice_50.mp3",
      "text": "討伐，開始。",
      "animation": "idle"
    },
    {
      "id": "voice_51",
      "category": "開始戰鬥I",
      "audio": "voices/voice_51.mp3",
      "text": "一網打盡。",
      "animation": "idle"
    },
    {
      "id": "voice_52",
      "category": "開始戰鬥I",
      "audio": "voices/voice_52.mp3",
      "text": "我……可以把它們全部炸掉吧？",
      "animation": "idle"
    },
    {
      "id": "voice_53",
      "category": "開始戰鬥II",
      "audio": "voices/voice_53.mp3",
      "text": "想像終於要化為現實了。",
      "animation": "idle"
    },
    {
      "id": "voice_54",
      "category": "開始戰鬥II",
      "audio": "voices/voice_54.mp3",
      "text": "我來炸飛你們這些怪物！",
      "animation": "idle"
    },
    {
      "id": "voice_55",
      "category": "開始戰鬥III",
      "audio": "voices/voice_55.mp3",
      "text": "一下子就能結束戰鬥。",
      "animation": "idle"
    },
    {
      "id": "voice_56",
      "category": "開始戰鬥III",
      "audio": "voices/voice_56.mp3",
      "text": "這一刻我等很久了……！",
      "animation": "idle"
    },
    {
      "id": "voice_57",
      "category": "換彈I",
      "audio": "voices/voice_57.mp3",
      "text": "子、子彈用完了。",
      "animation": "idle"
    },
    {
      "id": "voice_58",
      "category": "換彈I",
      "audio": "voices/voice_58.mp3",
      "text": "炮彈……不對，魔力耗盡了。",
      "animation": "idle"
    },
    {
      "id": "voice_59",
      "category": "換彈II",
      "audio": "voices/voice_59.mp3",
      "text": "……這樣就可以了吧？",
      "animation": "idle"
    },
    {
      "id": "voice_60",
      "category": "換彈II",
      "audio": "voices/voice_60.mp3",
      "text": "幫我擋一下槍吧……！",
      "animation": "idle"
    },
    {
      "id": "voice_61",
      "category": "換彈III",
      "audio": "voices/voice_61.mp3",
      "text": "嗨喲。",
      "animation": "idle"
    },
    {
      "id": "voice_62",
      "category": "換彈III",
      "audio": "voices/voice_62.mp3",
      "text": "能幫我拖延一下時間嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_63",
      "category": "可使用爆裂技能",
      "audio": "voices/voice_63.mp3",
      "text": "準、準備好了。",
      "animation": "idle"
    },
    {
      "id": "voice_64",
      "category": "可使用爆裂技能",
      "audio": "voices/voice_64.mp3",
      "text": "我、我來吟誦咒語。",
      "animation": "idle"
    },
    {
      "id": "voice_65",
      "category": "爆裂技能",
      "audio": "voices/voice_65.mp3",
      "text": "別、別過來。不然……你們就死定了。",
      "animation": "idle"
    },
    {
      "id": "voice_66",
      "category": "爆裂技能",
      "audio": "voices/voice_66.mp3",
      "text": "終極火焰爆裂！",
      "animation": "idle"
    },
    {
      "id": "voice_67",
      "category": "全爆裂",
      "audio": "voices/voice_67.mp3",
      "text": "把他們都打敗就可以了吧？",
      "animation": "idle"
    },
    {
      "id": "voice_68",
      "category": "全爆裂",
      "audio": "voices/voice_68.mp3",
      "text": "爆炸是藝術！……嘿嘿……！",
      "animation": "idle"
    },
    {
      "id": "voice_69",
      "category": "消滅敵人I",
      "audio": "voices/voice_69.mp3",
      "text": "殺，殺死了。",
      "animation": "idle"
    },
    {
      "id": "voice_70",
      "category": "消滅敵人I",
      "audio": "voices/voice_70.mp3",
      "text": "嘿、嘿嘿。",
      "animation": "idle"
    },
    {
      "id": "voice_71",
      "category": "消滅敵人II",
      "audio": "voices/voice_71.mp3",
      "text": "又殺死了一個！",
      "animation": "idle"
    },
    {
      "id": "voice_72",
      "category": "消滅敵人II",
      "audio": "voices/voice_72.mp3",
      "text": "爆炸了，爆炸啦……！",
      "animation": "idle"
    },
    {
      "id": "voice_73",
      "category": "消滅敵人III",
      "audio": "voices/voice_73.mp3",
      "text": "……我很厲害吧，指揮官大人？",
      "animation": "idle"
    },
    {
      "id": "voice_74",
      "category": "消滅敵人III",
      "audio": "voices/voice_74.mp3",
      "text": "接下來我們要炸什麼呢？",
      "animation": "idle"
    },
    {
      "id": "voice_75",
      "category": "被擊I",
      "audio": "voices/voice_75.mp3",
      "text": "啊！",
      "animation": "idle"
    },
    {
      "id": "voice_76",
      "category": "被擊I",
      "audio": "voices/voice_76.mp3",
      "text": "啊啊！",
      "animation": "idle"
    },
    {
      "id": "voice_77",
      "category": "被擊II",
      "audio": "voices/voice_77.mp3",
      "text": "啊啊！",
      "animation": "idle"
    },
    {
      "id": "voice_78",
      "category": "被擊II",
      "audio": "voices/voice_78.mp3",
      "text": "呃……！",
      "animation": "idle"
    },
    {
      "id": "voice_79",
      "category": "被擊III",
      "audio": "voices/voice_79.mp3",
      "text": "呼。",
      "animation": "idle"
    },
    {
      "id": "voice_80",
      "category": "被擊III",
      "audio": "voices/voice_80.mp3",
      "text": "唔。",
      "animation": "idle"
    },
    {
      "id": "voice_81",
      "category": "無法戰鬥",
      "audio": "voices/voice_81.mp3",
      "text": "抱、抱歉……",
      "animation": "idle"
    },
    {
      "id": "voice_82",
      "category": "無法戰鬥",
      "audio": "voices/voice_82.mp3",
      "text": "抱歉……後面……就拜託你了……",
      "animation": "idle"
    },
    {
      "id": "voice_83",
      "category": "戰鬥勝利",
      "audio": "voices/voice_83.mp3",
      "text": "你、你能……稱讚我嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_84",
      "category": "戰鬥勝利",
      "audio": "voices/voice_84.mp3",
      "text": "今、今天也是一次精彩的爆炸……\n這次……肯定有120分吧？",
      "animation": "idle"
    }
  ]
}