      "text": "換彈……",
      "animation": "idle"
    },
    {
      "id": "voice_31",
      "category": "換彈III",
      "audio": "voices/voice_31.mp3",
      "text": "我怎麼會知道如何換彈……？",
      "animation": "idle"
    },
    {
      "id": "voice_32",
