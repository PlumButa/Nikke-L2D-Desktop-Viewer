{
  "id": "317101",
  "resourceId": 171,
  "name": "尤爾夏",
  "skin": "預設",
  "spineVersion": "4.0",
  "skel": "c171_00.skel",
  "atlas": "c171_00.atlas",
  "defaultAnimation": "idle",
  "interactions": [
    {
      "id": "voice_01",
      "category": "在大廳點擊時I",
      "audio": "voices/voice_01.mp3",
      "text": "怎麼了？沒有什麼想說的嗎？",
      "animation": "action"
    },
    {
      "id": "voice_02",
      "category": "在大廳點擊時II",
      "audio": "voices/voice_02.mp3",
      "text": "你要銘記，方舟仍在中央政府的庇護下維持運轉。",
      "animation": "action"
    },
    {
      "id": "voice_03",
      "category": "在大廳點擊時III",
      "audio": "voices/voice_03.mp3",
      "text": "你要嘛就來替我幹活，不然少給我取什麼黑眼圈之類的外號。",
      "animation": "action"
    },
    {
      "id": "voice_04",
      "category": "在大廳點擊時（好感度10）I",
      "audio": "voices/voice_04.mp3",
      "text": "新人，被上級撞見會很麻煩的。\n適可而止，注意一下身體吧。",
      "animation": "action"
    },
    {
      "id": "voice_05",
      "category": "在大廳點擊時（好感度10）II",
      "audio": "voices/voice_05.mp3",
      "text": "有話就說，我在聽。",
      "animation": "action"
    },
    {
      "id": "voice_06",
      "category": "在大廳點擊時（好感度10）III",
      "audio": "voices/voice_06.mp3",
      "text": "別又像上次那樣說要代替我工作。\n顧好自己的身體吧。",
      "animation": "action"
    },
    {
      "id": "voice_07",
      "category": "在大廳閒置時",
      "audio": "voices/voice_07.mp3",
      "text": "在發什麼呆？怎麼還不行動？",
      "animation": "action"
    },
    {
      "id": "voice_08",
      "category": "在大廳閒置時（好感度10）I",
      "audio": "voices/voice_08.mp3",
      "text": "有什麼煩惱嗎？有煩惱就快說吧。\n你不說，怎麼知道我能不能幫你？",
      "animation": "shy"
    },
    {
      "id": "voice_09",
      "category": "在前哨基地點擊I",
      "audio": "voices/voice_09.mp3",
      "text": "那群妮姬吵死人了，你快來法院把她們帶走。",
      "animation": "action"
    },
    {
      "id": "voice_10",
      "category": "在前哨基地點擊II",
      "audio": "voices/voice_10.mp3",
      "text": "看來法院是扮家家酒的好地方。",
      "animation": "action"
    },
    {
      "id": "voice_11",
      "category": "在前哨基地點擊III",
      "audio": "voices/voice_11.mp3",
      "text": "哼，空氣這麼清新，讓我都睏了……",
      "animation": "action"
    },
    {
      "id": "voice_12",
      "category": "初次見面",
      "audio": "voices/voice_12.mp3",
      "text": "哎，又來了一堆麻煩。",
      "animation": "idle"
    },
    {
      "id": "voice_13",
      "category": "戰鬥力提升I",
      "audio": "voices/voice_13.mp3",
      "text": "感謝支援，但你需要我做什麼？",
      "animation": "idle"
    },
    {
      "id": "voice_14",
      "category": "戰鬥力提升II",
      "audio": "voices/voice_14.mp3",
      "text": "我會用行動報答你的信任。",
      "animation": "idle"
    },
    {
      "id": "voice_15",
      "category": "戰鬥力提升III",
      "audio": "voices/voice_15.mp3",
      "text": "強化到這個程度，你應該受了不少苦吧。",
      "animation": "idle"
    },
    {
      "id": "voice_16",
      "category": "禮物I",
      "audio": "voices/voice_16.mp3",
      "text": "你要把這個給我？為什麼？",
      "animation": "idle"
    },
    {
      "id": "voice_17",
      "category": "禮物II",
      "audio": "voices/voice_17.mp3",
      "text": "新人……謝……啊，這種話我說不出口啊！",
      "animation": "idle"
    },
    {
      "id": "voice_18",
      "category": "禮物III",
      "audio": "voices/voice_18.mp3",
      "text": "有言在先啊，就算你送我禮物，也不會改變什麼哦。",
      "animation": "idle"
    },
    {
      "id": "voice_19",
      "category": "好感度提升I",
      "audio": "voices/voice_19.mp3",
      "text": "別總在我身邊晃來晃去，煩死了。",
      "animation": "shy"
    },
    {
      "id": "voice_20",
      "category": "好感度提升II",
      "audio": "voices/voice_20.mp3",
      "text": "啊啊，害我越來越在意了。真是的！",
      "animation": "shy"
    },
    {
      "id": "voice_21",
      "category": "好感度提升III",
      "audio": "voices/voice_21.mp3",
      "text": "新人！我最討厭欠人情了。\n不管你是好意還是真情，我都會報答你的。",
      "animation": "shy"
    },
    {
      "id": "voice_22",
      "category": "編隊",
      "audio": "voices/voice_22.mp3",
      "text": "準備好出發了嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_23",
      "category": "在野外點擊部隊",
      "audio": "voices/voice_23.mp3",
      "text": "什麼呀？說吧。",
      "animation": "idle"
    },
    {
      "id": "voice_24",
      "category": "在野外移動部隊",
      "audio": "voices/voice_24.mp3",
      "text": "知道了。",
      "animation": "idle"
    },
    {
      "id": "voice_25",
      "category": "進入戰鬥",
      "audio": "voices/voice_25.mp3",
      "text": "投入戰鬥。",
      "animation": "idle"
    },
    {
      "id": "voice_26",
      "category": "開始戰鬥I",
      "audio": "voices/voice_26.mp3",
      "text": "別慌，我們能贏。",
      "animation": "idle"
    },
    {
      "id": "voice_27",
      "category": "開始戰鬥II",
      "audio": "voices/voice_27.mp3",
      "text": "新人，指揮的任務交給你了。",
      "animation": "idle"
    },
    {
      "id": "voice_28",
      "category": "開始戰鬥III",
      "audio": "voices/voice_28.mp3",
      "text": "作戰，開始。",
      "animation": "idle"
    },
    {
      "id": "voice_29",
      "category": "換彈I",
      "audio": "voices/voice_29.mp3",
      "text": "哼，耗時比預想還要久啊。",
      "animation": "idle"
    },
    {
      "id": "voice_30",
      "category": "換彈II",
      "audio": "voices/voice_30.mp3",
      "text": "新人，還挺得住吧？",
      "animation": "idle"
    },
    {
      "id": "voice_31",
      "category": "換彈III",
      "audio": "voices/voice_31.mp3",
      "text": "我要重新裝彈再走。",
      "animation": "idle"
    },
    {
      "id": "voice_32",
      "category": "可使用爆裂技能",
      "audio": "voices/voice_32.mp3",
      "text": "新人！",
      "animation": "idle"
    },
    {
      "id": "voice_33",
      "category": "爆裂技能",
      "audio": "voices/voice_33.mp3",
      "text": "我忙得要死，你們識相的就給我滾開！",
      "animation": "idle"
    },
    {
      "id": "voice_34",
      "category": "全爆裂",
      "audio": "voices/voice_34.mp3",
      "text": "謝絕加班！全部消滅！",
      "animation": "idle"
    },
    {
      "id": "voice_35",
      "category": "消滅敵人I",
      "audio": "voices/voice_35.mp3",
      "text": "目標已清除。",
      "animation": "idle"
    },
    {
      "id": "voice_36",
      "category": "消滅敵人II",
      "audio": "voices/voice_36.mp3",
      "text": "下一個目標是？",
      "animation": "idle"
    },
    {
      "id": "voice_37",
      "category": "消滅敵人III",
      "audio": "voices/voice_37.mp3",
      "text": "真痛快。",
      "animation": "idle"
    },
    {
      "id": "voice_38",
      "category": "被擊I",
      "audio": "voices/voice_38.mp3",
      "text": "哼。",
      "animation": "idle"
    },
    {
      "id": "voice_39",
      "category": "被擊II",
      "audio": "voices/voice_39.mp3",
      "text": "他媽的。",
      "animation": "idle"
    },
    {
      "id": "voice_40",
      "category": "被擊III",
      "audio": "voices/voice_40.mp3",
      "text": "呃！",
      "animation": "idle"
    },
    {
      "id": "voice_41",
      "category": "無法戰鬥",
      "audio": "voices/voice_41.mp3",
      "text": "哼～抱歉了，新人。",
      "animation": "idle"
    },
    {
      "id": "voice_42",
      "category": "戰鬥勝利",
      "audio": "voices/voice_42.mp3",
      "text": "戰鬥結束，辛苦了。",
      "animation": "idle"
    }
  ]
}