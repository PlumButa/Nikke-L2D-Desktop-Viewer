{
  "id": "583401",
  "resourceId": 834,
  "name": "零（暫稱）",
  "skin": "預設",
  "spineVersion": "4.0",
  "skel": "c834_00.skel",
  "atlas": "c834_00.atlas",
  "defaultAnimation": "idle",
  "interactions": [
    {
      "id": "voice_01",
      "category": "在大廳點擊時I",
      "audio": "voices/voice_01.mp3",
      "text": "圖書館，怎麼走？",
      "animation": "action"
    },
    {
      "id": "voice_02",
      "category": "在大廳點擊時I",
      "audio": "voices/voice_02.mp3",
      "text": "我，稍微學習了樂器。",
      "animation": "action"
    },
    {
      "id": "voice_03",
      "category": "在大廳點擊時II",
      "audio": "voices/voice_03.mp3",
      "text": "這裡也在放著音樂。",
      "animation": "action"
    },
    {
      "id": "voice_04",
      "category": "在大廳點擊時II",
      "audio": "voices/voice_04.mp3",
      "text": "大家看起來很開心，怎麼了？",
      "animation": "action"
    },
    {
      "id": "voice_05",
      "category": "在大廳點擊時III",
      "audio": "voices/voice_05.mp3",
      "text": "不用駕駛EVA的幸福……",
      "animation": "action"
    },
    {
      "id": "voice_06",
      "category": "在大廳點擊時III",
      "audio": "voices/voice_06.mp3",
      "text": "妮姬的大家教了我，\n和平就是能隨時舉辦宴會。",
      "animation": "action"
    },
    {
      "id": "voice_07",
      "category": "在大廳點擊時（好感度10）I",
      "audio": "voices/voice_07.mp3",
      "text": "和大家一起在這裡，我很開心。",
      "animation": "action"
    },
    {
      "id": "voice_08",
      "category": "在大廳點擊時（好感度10）I",
      "audio": "voices/voice_08.mp3",
      "text": "演奏，要聽嗎？",
      "animation": "action"
    },
    {
      "id": "voice_09",
      "category": "在大廳點擊時（好感度10）II",
      "audio": "voices/voice_09.mp3",
      "text": "不用再駕駛EVA也可以了……",
      "animation": "action"
    },
    {
      "id": "voice_10",
      "category": "在大廳點擊時（好感度10）II",
      "audio": "voices/voice_10.mp3",
      "text": "消滅萊徹，然後回來繼續練習。",
      "animation": "action"
    },
    {
      "id": "voice_11",
      "category": "在大廳點擊時（好感度10）III",
      "audio": "voices/voice_11.mp3",
      "text": "我也會保護你。",
      "animation": "action"
    },
    {
      "id": "voice_12",
      "category": "在大廳點擊時（好感度10）III",
      "audio": "voices/voice_12.mp3",
      "text": "暖暖的……",
      "animation": "action"
    },
    {
      "id": "voice_13",
      "category": "在大廳閒置時",
      "audio": "voices/voice_13.mp3",
      "text": "嗯？",
      "animation": "action"
    },
    {
      "id": "voice_14",
      "category": "在大廳閒置時",
      "audio": "voices/voice_14.mp3",
      "text": "我還在練習。",
      "animation": "action"
    },
    {
      "id": "voice_15",
      "category": "在大廳閒置時（好感度10）I",
      "audio": "voices/voice_15.mp3",
      "text": "有我能做的事嗎？",
      "animation": "shy"
    },
    {
      "id": "voice_16",
      "category": "在大廳閒置時（好感度10）I",
      "audio": "voices/voice_16.mp3",
      "text": "下一次……還會有音樂嗎？",
      "animation": "shy"
    },
    {
      "id": "voice_17",
      "category": "在前哨基地點擊I",
      "audio": "voices/voice_17.mp3",
      "text": "這就是你們的村子嗎？",
      "animation": "action"
    },
    {
      "id": "voice_18",
      "category": "在前哨基地點擊I",
      "audio": "voices/voice_18.mp3",
      "text": "這裡，有貓？",
      "animation": "action"
    },
    {
      "id": "voice_19",
      "category": "在前哨基地點擊II",
      "audio": "voices/voice_19.mp3",
      "text": "這裡也有工作嗎？",
      "animation": "action"
    },
    {
      "id": "voice_20",
      "category": "在前哨基地點擊II",
      "audio": "voices/voice_20.mp3",
      "text": "這裡有小寶寶嗎？",
      "animation": "action"
    },
    {
      "id": "voice_21",
      "category": "在前哨基地點擊III",
      "audio": "voices/voice_21.mp3",
      "text": "這些廢墟，也是萊徹的原因嗎？",
      "animation": "action"
    },
    {
      "id": "voice_22",
      "category": "在前哨基地點擊III",
      "audio": "voices/voice_22.mp3",
      "text": "保護這裡，就是你的工作嗎？",
      "animation": "action"
    },
    {
      "id": "voice_23",
      "category": "初次見面",
      "audio": "voices/voice_23.mp3",
      "text": "名字……？我不知道。",
      "animation": "idle"
    },
    {
      "id": "voice_24",
      "category": "初次見面",
      "audio": "voices/voice_24.mp3",
      "text": "衣服，軟乎乎的。",
      "animation": "idle"
    },
    {
      "id": "voice_25",
      "category": "戰鬥力提升I",
      "audio": "voices/voice_25.mp3",
      "text": "變得強大……那是什麼？",
      "animation": "idle"
    },
    {
      "id": "voice_26",
      "category": "戰鬥力提升I",
      "audio": "voices/voice_26.mp3",
      "text": "訓練，但是，衣服不一樣。",
      "animation": "idle"
    },
    {
      "id": "voice_27",
      "category": "戰鬥力提升II",
      "audio": "voices/voice_27.mp3",
      "text": "這種感覺……",
      "animation": "idle"
    },
    {
      "id": "voice_28",
      "category": "戰鬥力提升II",
      "audio": "voices/voice_28.mp3",
      "text": "很習慣。",
      "animation": "idle"
    },
    {
      "id": "voice_29",
      "category": "戰鬥力提升III",
      "audio": "voices/voice_29.mp3",
      "text": "我會做到的。",
      "animation": "idle"
    },
    {
      "id": "voice_30",
      "category": "戰鬥力提升III",
      "audio": "voices/voice_30.mp3",
      "text": "我，變強了。",
      "animation": "idle"
    },
    {
      "id": "voice_31",
      "category": "禮物I",
      "audio": "voices/voice_31.mp3",
      "text": "禮物？",
      "animation": "idle"
    },
    {
      "id": "voice_32",
      "category": "禮物I",
      "audio": "voices/voice_32.mp3",
      "text": "亮閃閃的。",
      "animation": "idle"
    },
    {
      "id": "voice_33",
      "category": "禮物II",
      "audio": "voices/voice_33.mp3",
      "text": "謝謝。\n這樣說對嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_34",
      "category": "禮物II",
      "audio": "voices/voice_34.mp3",
      "text": "給我嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_35",
      "category": "禮物III",
      "audio": "voices/voice_35.mp3",
      "text": "這就是……喜悅？",
      "animation": "idle"
    },
    {
      "id": "voice_36",
      "category": "禮物III",
      "audio": "voices/voice_36.mp3",
      "text": "我的音樂，作為回報。",
      "animation": "idle"
    },
    {
      "id": "voice_37",
      "category": "好感度提升I",
      "audio": "voices/voice_37.mp3",
      "text": "還想和大家一起玩。",
      "animation": "shy"
    },
    {
      "id": "voice_38",
      "category": "好感度提升I",
      "audio": "voices/voice_38.mp3",
      "text": "大家一起演奏出聲音……就是，音樂。",
      "animation": "shy"
    },
    {
      "id": "voice_39",
      "category": "好感度提升II",
      "audio": "voices/voice_39.mp3",
      "text": "握手吧。這是讓我們關係變好起來的咒語。",
      "animation": "shy"
    },
    {
      "id": "voice_40",
      "category": "好感度提升II",
      "audio": "voices/voice_40.mp3",
      "text": "演奏，很開心。",
      "animation": "shy"
    },
    {
      "id": "voice_41",
      "category": "好感度提升III",
      "audio": "voices/voice_41.mp3",
      "text": "這裡也是……我要保護的地方。",
      "animation": "shy"
    },
    {
      "id": "voice_42",
      "category": "好感度提升III",
      "audio": "voices/voice_42.mp3",
      "text": "我可以一直練習嗎？",
      "animation": "shy"
    },
    {
      "id": "voice_43",
      "category": "編隊",
      "audio": "voices/voice_43.mp3",
      "text": "新世紀福音戰士，沒有。",
      "animation": "idle"
    },
    {
      "id": "voice_44",
      "category": "編隊",
      "audio": "voices/voice_44.mp3",
      "text": "行動的時間。",
      "animation": "idle"
    },
    {
      "id": "voice_45",
      "category": "在野外點擊部隊",
      "audio": "voices/voice_45.mp3",
      "text": "嗯。",
      "animation": "idle"
    },
    {
      "id": "voice_46",
      "category": "在野外點擊部隊",
      "audio": "voices/voice_46.mp3",
      "text": "敵人，在哪裡？",
      "animation": "idle"
    },
    {
      "id": "voice_47",
      "category": "在野外移動部隊",
      "audio": "voices/voice_47.mp3",
      "text": "命令確認。",
      "animation": "idle"
    },
    {
      "id": "voice_48",
      "category": "在野外移動部隊",
      "audio": "voices/voice_48.mp3",
      "text": "大家的笑聲和音樂……聽不到。",
      "animation": "idle"
    },
    {
      "id": "voice_49",
      "category": "進入戰鬥",
      "audio": "voices/voice_49.mp3",
      "text": "準備迎敵。",
      "animation": "idle"
    },
    {
      "id": "voice_50",
      "category": "進入戰鬥",
      "audio": "voices/voice_50.mp3",
      "text": "任務開始。",
      "animation": "idle"
    },
    {
      "id": "voice_51",
      "category": "開始戰鬥I",
      "audio": "voices/voice_51.mp3",
      "text": "命令。",
      "animation": "idle"
    },
    {
      "id": "voice_52",
      "category": "開始戰鬥I",
      "audio": "voices/voice_52.mp3",
      "text": "是。",
      "animation": "idle"
    },
    {
      "id": "voice_53",
      "category": "開始戰鬥II",
      "audio": "voices/voice_53.mp3",
      "text": "我明白了。",
      "animation": "idle"
    },
    {
      "id": "voice_54",
      "category": "開始戰鬥II",
      "audio": "voices/voice_54.mp3",
      "text": "投入戰鬥。",
      "animation": "idle"
    },
    {
      "id": "voice_55",
      "category": "開始戰鬥III",
      "audio": "voices/voice_55.mp3",
      "text": "出擊。",
      "animation": "idle"
    },
    {
      "id": "voice_56",
      "category": "開始戰鬥III",
      "audio": "voices/voice_56.mp3",
      "text": "準備完成。",
      "animation": "idle"
    },
    {
      "id": "voice_57",
      "category": "換彈I",
      "audio": "voices/voice_57.mp3",
      "text": "正在裝彈。",
      "animation": "idle"
    },
    {
      "id": "voice_58",
      "category": "換彈I",
      "audio": "voices/voice_58.mp3",
      "text": "很快就能裝好。",
      "animation": "idle"
    },
    {
      "id": "voice_59",
      "category": "換彈II",
      "audio": "voices/voice_59.mp3",
      "text": "請稍等。",
      "animation": "idle"
    },
    {
      "id": "voice_60",
      "category": "換彈II",
      "audio": "voices/voice_60.mp3",
      "text": "沒有子彈。",
      "animation": "idle"
    },
    {
      "id": "voice_61",
      "category": "換彈III",
      "audio": "voices/voice_61.mp3",
      "text": "換彈。",
      "animation": "idle"
    },
    {
      "id": "voice_62",
      "category": "換彈III",
      "audio": "voices/voice_62.mp3",
