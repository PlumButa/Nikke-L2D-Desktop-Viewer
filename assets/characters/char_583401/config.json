      "animation": "idle"
    },
    {
      "id": "voice_75",
      "category": "被擊I",
      "audio": "voices/voice_75.mp3",
      "text": "呃……",
      "animation": "idle"
    },
    {
      "id": "voice_76",
      "category": "被擊I",
      "audio": "voices/voice_76.mp3",
      "text": "嗚……",
      "animation": "idle"
    },
    {
      "id": "voice_77",
      "category": "被擊II",
      "audio": "voices/voice_77.mp3",
      "text": "唔……",
      "animation": "idle"
    },
    {
      "id": "voice_78",
      "category": "被擊II",
      "audio": "voices/voice_78.mp3",
      "text": "嘶……",
      "animation": "idle"
    },
    {
      "id": "voice_79",
      "category": "被擊III",
      "audio": "voices/voice_79.mp3",
      "text": "受擊。",
      "animation": "idle"
    },
    {
      "id": "voice_80",
      "category": "被擊III",
      "audio": "voices/voice_80.mp3",
