{
  "id": "319101",
  "resourceId": 191,
  "name": "愛麗絲",
  "skin": "預設",
  "spineVersion": "4.0",
  "skel": "c191_00.skel",
  "atlas": "c191_00.atlas",
  "defaultAnimation": "idle",
  "interactions": [
    {
      "id": "voice_01",
      "category": "在大廳點擊時I",
      "audio": "voices/voice_01.mp3",
      "text": "兔子先生～我們去吃紅蘿蔔吧？",
      "animation": "action"
    },
    {
      "id": "voice_02",
      "category": "在大廳點擊時I",
      "audio": "voices/voice_02.mp3",
      "text": "蹦蹦～跳跳～\n要去見誰啊～？",
      "animation": "action"
    },
    {
      "id": "voice_03",
      "category": "在大廳點擊時I",
      "audio": "voices/voice_03.mp3",
      "text": "聽說很快就會舉辦一場\n超棒的茶會耶～！",
      "animation": "action"
    },
    {
      "id": "voice_04",
      "category": "在大廳點擊時II",
      "audio": "voices/voice_04.mp3",
      "text": "山兔子呀山兔子～你要去哪裡～",
      "animation": "action"
    },
    {
      "id": "voice_05",
      "category": "在大廳點擊時II",
      "audio": "voices/voice_05.mp3",
      "text": "您覺得我怎麼樣？可愛嗎～？",
      "animation": "action"
    },
    {
      "id": "voice_06",
      "category": "在大廳點擊時II",
      "audio": "voices/voice_06.mp3",
      "text": "這裡有好多兔子先生的朋友喔！",
      "animation": "action"
    },
    {
      "id": "voice_07",
      "category": "在大廳點擊時III",
      "audio": "voices/voice_07.mp3",
      "text": "只要和兔子先生在一起，我就很幸福～",
      "animation": "action"
    },
    {
      "id": "voice_08",
      "category": "在大廳點擊時III",
      "audio": "voices/voice_08.mp3",
      "text": "聽說兔子要像這樣跳，對嗎？蹦蹦！",
      "animation": "action"
    },
    {
      "id": "voice_09",
      "category": "在大廳點擊時III",
      "audio": "voices/voice_09.mp3",
      "text": "不覺得很像走進童話世界裡嗎？",
      "animation": "action"
    },
    {
      "id": "voice_10",
      "category": "在大廳點擊時（好感度10）I",
      "audio": "voices/voice_10.mp3",
      "text": "兔子先生送給我的書，我已經讀完啦！",
      "animation": "action"
    },
    {
      "id": "voice_11",
      "category": "在大廳點擊時（好感度10）I",
      "audio": "voices/voice_11.mp3",
      "text": "我想整天都和兔子先生待在一起～",
      "animation": "action"
    },
    {
      "id": "voice_12",
      "category": "在大廳點擊時（好感度10）I",
      "audio": "voices/voice_12.mp3",
      "text": "這正是我夢想中的幸福世界呢～！\n兔子先生，謝謝您陪我一起來～",
      "animation": "action"
    },
    {
      "id": "voice_13",
      "category": "在大廳點擊時（好感度10）II",
      "audio": "voices/voice_13.mp3",
      "text": "兔子先生……您能牽住我的手嗎？",
      "animation": "action"
    },
    {
      "id": "voice_14",
      "category": "在大廳點擊時（好感度10）II",
      "audio": "voices/voice_14.mp3",
      "text": "我要出發去愛的樂園！\n您要一起去嗎～？",
      "animation": "action"
    },
    {
      "id": "voice_15",
      "category": "在大廳點擊時（好感度10）II",
      "audio": "voices/voice_15.mp3",
      "text": "兔子先生的座位，就在我的旁邊！\n因為我超級無敵喜歡兔子先生的！",
      "animation": "action"
    },
    {
      "id": "voice_16",
      "category": "在大廳點擊時（好感度10）III",
      "audio": "voices/voice_16.mp3",
      "text": "兔子先生永遠是我的樂園。",
      "animation": "action"
    },
    {
      "id": "voice_17",
      "category": "在大廳點擊時（好感度10）III",
      "audio": "voices/voice_17.mp3",
      "text": "和我一起去吃雲朵般的棉花糖吧！",
      "animation": "action"
    },
    {
      "id": "voice_18",
      "category": "在大廳點擊時（好感度10）III",
      "audio": "voices/voice_18.mp3",
      "text": "從夢中醒來也沒關係，\n因為有兔子先生會陪在我的身邊～！",
      "animation": "action"
    },
    {
      "id": "voice_19",
      "category": "在大廳閒置時",
      "audio": "voices/voice_19.mp3",
      "text": "嗯……兔子先生……您丟下我，一個人去幸福的世界了嗎？",
      "animation": "action"
    },
    {
      "id": "voice_20",
      "category": "在大廳閒置時",
      "audio": "voices/voice_20.mp3",
      "text": "兔子先生～您在哪裡啊～？\n我們不是說好要一起去方舟玩嗎～？",
      "animation": "action"
    },
    {
      "id": "voice_21",
      "category": "在大廳閒置時",
      "audio": "voices/voice_21.mp3",
      "text": "嗚嗚……兔子先生不在，\n茶會就開始不了了……",
      "animation": "action"
    },
    {
      "id": "voice_22",
      "category": "在大廳閒置時（好感度10）I",
      "audio": "voices/voice_22.mp3",
      "text": "兔子先生～帶我一起去幸福的世界吧～",
      "animation": "shy"
    },
    {
      "id": "voice_23",
      "category": "在大廳閒置時（好感度10）I",
      "audio": "voices/voice_23.mp3",
      "text": "一想到我們要一起玩，我就好興奮啊！\n所以您要快點來喔！",
      "animation": "shy"
    },
    {
      "id": "voice_24",
      "category": "在大廳閒置時（好感度10）I",
      "audio": "voices/voice_24.mp3",
      "text": "兔子先生～您在做一個很幸福的夢嗎？\n請邀請我到那個夢裡！",
      "animation": "shy"
    },
    {
      "id": "voice_25",
      "category": "在前哨基地點擊I",
      "audio": "voices/voice_25.mp3",
      "text": "兔子先生！我們要不要蹦蹦跳跳玩耍呢？",
      "animation": "action"
    },
    {
      "id": "voice_26",
      "category": "在前哨基地點擊I",
      "audio": "voices/voice_26.mp3",
      "text": "您問我想去哪裡～？去哪裡都可以！",
      "animation": "action"
    },
    {
      "id": "voice_27",
      "category": "在前哨基地點擊I",
      "audio": "voices/voice_27.mp3",
      "text": "大家都在笑耶！\n大概是因為這裡是個幸福的世界吧～",
      "animation": "action"
    },
    {
      "id": "voice_28",
      "category": "在前哨基地點擊II",
      "audio": "voices/voice_28.mp3",
      "text": "我在一個叫「服裝店」的地方。兔子先生也要過來看看嗎？",
      "animation": "action"
    },
    {
      "id": "voice_29",
      "category": "在前哨基地點擊II",
      "audio": "voices/voice_29.mp3",
      "text": "嗯～我想去玩具店！",
      "animation": "action"
    },
    {
      "id": "voice_30",
      "category": "在前哨基地點擊II",
      "audio": "voices/voice_30.mp3",
      "text": "我想跟兔子先生一起並肩散步！",
      "animation": "action"
    },
    {
      "id": "voice_31",
      "category": "在前哨基地點擊III",
      "audio": "voices/voice_31.mp3",
      "text": "服裝店是衣服的世界！還有很多公主裝哦！",
      "animation": "action"
    },
    {
      "id": "voice_32",
      "category": "在前哨基地點擊III",
      "audio": "voices/voice_32.mp3",
      "text": "我想要手牽著手在公園裡散步～",
      "animation": "action"
    },
    {
      "id": "voice_33",
      "category": "在前哨基地點擊III",
      "audio": "voices/voice_33.mp3",
      "text": "如果在這裡舉行茶會，\n一定會有很多客人來！",
      "animation": "action"
    },
    {
      "id": "voice_34",
      "category": "初次見面",
      "audio": "voices/voice_34.mp3",
      "text": "兔子先生！您會帶我們去幸福的世界嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_35",
      "category": "初次見面",
      "audio": "voices/voice_35.mp3",
      "text": "您想邀請我去方舟玩嗎？！\n太好了！",
      "animation": "idle"
    },
    {
      "id": "voice_36",
      "category": "初次見面",
      "audio": "voices/voice_36.mp3",
      "text": "兔子先生，歡迎光臨～\n這裡是我的夢境～！",
      "animation": "idle"
    },
    {
      "id": "voice_37",
      "category": "戰鬥力提升I",
      "audio": "voices/voice_37.mp3",
      "text": "哇啊～我變強了嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_38",
      "category": "戰鬥力提升I",
      "audio": "voices/voice_38.mp3",
      "text": "我可以玩一整天！",
      "animation": "idle"
    },
    {
      "id": "voice_39",
      "category": "戰鬥力提升I",
      "audio": "voices/voice_39.mp3",
      "text": "哇！感覺好像在天空飛一樣！",
      "animation": "idle"
    },
    {
      "id": "voice_40",
      "category": "戰鬥力提升II",
      "audio": "voices/voice_40.mp3",
      "text": "咦？好像有力量湧出來了耶！",
      "animation": "idle"
    },
    {
      "id": "voice_41",
      "category": "戰鬥力提升II",
      "audio": "voices/voice_41.mp3",
      "text": "蹦蹦～跳跳～！",
      "animation": "idle"
    },
    {
      "id": "voice_42",
      "category": "戰鬥力提升II",
      "audio": "voices/voice_42.mp3",
      "text": "在這裡由我來守護兔子先生！",
      "animation": "idle"
    },
    {
      "id": "voice_43",
      "category": "戰鬥力提升III",
      "audio": "voices/voice_43.mp3",
      "text": "以後是不是可以玩得更開心了呢？",
      "animation": "idle"
    },
    {
      "id": "voice_44",
      "category": "戰鬥力提升III",
      "audio": "voices/voice_44.mp3",
      "text": "哇——！兔子先生，謝謝您把力量分享給我！",
      "animation": "idle"
    },
    {
      "id": "voice_45",
      "category": "戰鬥力提升III",
      "audio": "voices/voice_45.mp3",
      "text": "我怎麼樣？是不是變得很可靠？",
      "animation": "idle"
    },
    {
      "id": "voice_46",
      "category": "禮物I",
      "audio": "voices/voice_46.mp3",
      "text": "您要……送我禮物？",
      "animation": "idle"
    },
    {
      "id": "voice_47",
      "category": "禮物I",
      "audio": "voices/voice_47.mp3",
      "text": "這就是那個很有名的方舟紀念品嗎？謝謝您！",
      "animation": "idle"
    },
    {
      "id": "voice_48",
      "category": "禮物I",
      "audio": "voices/voice_48.mp3",
      "text": "哇——這個禮物好夢幻喔～！",
      "animation": "idle"
    },
    {
      "id": "voice_49",
      "category": "禮物II",
      "audio": "voices/voice_49.mp3",
      "text": "謝謝您！兔子先生！",
      "animation": "idle"
    },
    {
      "id": "voice_50",
      "category": "禮物II",
      "audio": "voices/voice_50.mp3",
      "text": "兔子先生的禮物……我會珍藏一輩子！",
      "animation": "idle"
    },
    {
      "id": "voice_51",
      "category": "禮物II",
      "audio": "voices/voice_51.mp3",
      "text": "作為回報，我會邀請您參加一場很棒的茶會！",
      "animation": "idle"
    },
    {
      "id": "voice_52",
      "category": "禮物III",
      "audio": "voices/voice_52.mp3",
      "text": "下次我送您禮物！我保證！",
      "animation": "idle"
    },
    {
      "id": "voice_53",
      "category": "禮物III",
      "audio": "voices/voice_53.mp3",
      "text": "我也要送您禮物！\n您想要什麼～？",
      "animation": "idle"
    },
    {
      "id": "voice_54",
      "category": "禮物III",
      "audio": "voices/voice_54.mp3",
      "text": "只要是兔子先生給的東西，我都喜歡！",
      "animation": "idle"
    },
    {
      "id": "voice_55",
      "category": "好感度提升I",
      "audio": "voices/voice_55.mp3",
      "text": "我好喜歡兔子先生！真的超級喜歡！",
      "animation": "shy"
    },
    {
      "id": "voice_56",
      "category": "好感度提升I",
      "audio": "voices/voice_56.mp3",
      "text": "我想和兔子先生一直在一起～",
      "animation": "shy"
    },
    {
      "id": "voice_57",
      "category": "好感度提升I",
      "audio": "voices/voice_57.mp3",
      "text": "我要在這裡和兔子先生幸福地過一輩子！",
      "animation": "shy"
    },
    {
      "id": "voice_58",
      "category": "好感度提升II",
      "audio": "voices/voice_58.mp3",
      "text": "兔子先生，我要牽您的手！",
      "animation": "shy"
    },
    {
      "id": "voice_59",
      "category": "好感度提升II",
      "audio": "voices/voice_59.mp3",
      "text": "感覺這裡就是充滿幸福的世界！",
      "animation": "shy"
    },
    {
      "id": "voice_60",
      "category": "好感度提升II",
      "audio": "voices/voice_60.mp3",
      "text": "撲通撲通！在夢裡也瘋狂小鹿亂撞呢！",
      "animation": "shy"
    },
    {
      "id": "voice_61",
      "category": "好感度提升III",
      "audio": "voices/voice_61.mp3",
      "text": "不能現在就和兔子先生一起去幸福的世界嗎？",
      "animation": "shy"
    },
    {
      "id": "voice_62",
      "category": "好感度提升III",
      "audio": "voices/voice_62.mp3",
      "text": "我又變得更～加喜歡您了！",
      "animation": "shy"
    },
    {
      "id": "voice_63",
      "category": "好感度提升III",
      "audio": "voices/voice_63.mp3",
      "text": "感覺我好像變成童話世界裡的公主……！",
      "animation": "shy"
    },
    {
      "id": "voice_64",
      "category": "編隊",
      "audio": "voices/voice_64.mp3",
      "text": "喜歡跟兔子先生一起去！",
      "animation": "idle"
    },
    {
      "id": "voice_65",
      "category": "編隊",
      "audio": "voices/voice_65.mp3",
      "text": "您能告訴我這是要去哪裡嗎～？",
      "animation": "idle"
    },
    {
      "id": "voice_66",
      "category": "編隊",
      "audio": "voices/voice_66.mp3",
      "text": "一起前往幸福的世界吧～！",
      "animation": "idle"
    },
    {
      "id": "voice_67",
      "category": "在野外點擊部隊",
      "audio": "voices/voice_67.mp3",
      "text": "是兔子先生耶！",
      "animation": "idle"
    },
    {
      "id": "voice_68",
      "category": "在野外點擊部隊",
      "audio": "voices/voice_68.mp3",
      "text": "您在叫我嗎～？",
      "animation": "idle"
    },
    {
      "id": "voice_69",
      "category": "在野外點擊部隊",
      "audio": "voices/voice_69.mp3",
      "text": "是！我在這裡！",
      "animation": "idle"
    },
    {
      "id": "voice_70",
      "category": "在野外移動部隊",
      "audio": "voices/voice_70.mp3",
      "text": "哇啊啊啊——！",
      "animation": "idle"
    },
    {
      "id": "voice_71",
      "category": "在野外移動部隊",
      "audio": "voices/voice_71.mp3",
      "text": "一起去吧。",
      "animation": "idle"
    },
    {
      "id": "voice_72",
      "category": "在野外移動部隊",
      "audio": "voices/voice_72.mp3",
      "text": "一步～兩步～",
      "animation": "idle"
    },
    {
      "id": "voice_73",
      "category": "進入戰鬥",
      "audio": "voices/voice_73.mp3",
      "text": "哇，遇敵了！",
      "animation": "idle"
    },
    {
      "id": "voice_74",
      "category": "進入戰鬥",
      "audio": "voices/voice_74.mp3",
      "text": "開心地玩耍吧～！",
      "animation": "idle"
    },
    {
      "id": "voice_75",
      "category": "進入戰鬥",
      "audio": "voices/voice_75.mp3",
      "text": "各位也是來參加茶會的嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_76",
      "category": "開始戰鬥I",
      "audio": "voices/voice_76.mp3",
      "text": "我們玩得開心一點吧！",
      "animation": "idle"
    },
    {
      "id": "voice_77",
      "category": "開始戰鬥I",
      "audio": "voices/voice_77.mp3",
      "text": "大家加油喔～！",
      "animation": "idle"
    },
    {
      "id": "voice_78",
      "category": "開始戰鬥I",
      "audio": "voices/voice_78.mp3",
      "text": "一起來玩吧～！",
      "animation": "idle"
    },
    {
      "id": "voice_79",
      "category": "開始戰鬥II",
      "audio": "voices/voice_79.mp3",
      "text": "大家都不要皺著眉頭嘛～",
      "animation": "idle"
    },
    {
      "id": "voice_80",
      "category": "開始戰鬥II",
      "audio": "voices/voice_80.mp3",
      "text": "讓您見識一下兔子之力！",
      "animation": "idle"
    },
    {
      "id": "voice_81",
      "category": "開始戰鬥II",
      "audio": "voices/voice_81.mp3",
      "text": "您好～",
      "animation": "idle"
    },
    {
      "id": "voice_82",
      "category": "開始戰鬥III",
      "audio": "voices/voice_82.mp3",
      "text": "兔子先生～一起玩吧！",
      "animation": "idle"
    },
    {
      "id": "voice_83",
      "category": "開始戰鬥III",
      "audio": "voices/voice_83.mp3",
      "text": "快點結束，一起去玩吧～",
      "animation": "idle"
    },
    {
      "id": "voice_84",
      "category": "開始戰鬥III",
      "audio": "voices/voice_84.mp3",
      "text": "好多客人喔～",
      "animation": "idle"
    },
    {
      "id": "voice_85",
      "category": "換彈I",
      "audio": "voices/voice_85.mp3",
      "text": "躲起來了！",
      "animation": "idle"
    },
    {
      "id": "voice_86",
      "category": "換彈I",
      "audio": "voices/voice_86.mp3",
      "text": "一～二～",
      "animation": "idle"
    },
    {
      "id": "voice_87",
      "category": "換彈I",
      "audio": "voices/voice_87.mp3",
      "text": "食材都用完了！",
      "animation": "idle"
    },
    {
      "id": "voice_88",
      "category": "換彈II",
      "audio": "voices/voice_88.mp3",
