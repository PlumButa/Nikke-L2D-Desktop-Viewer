{
  "id": "352001",
  "resourceId": 520,
  "name": "布蕾德",
  "skin": "糖霜咬咬",
  "spineVersion": "4.0",
  "skel": "c520_01_00.skel",
  "atlas": "c520_01_00.atlas",
  "defaultAnimation": "idle",
  "interactions": [
    {
      "id": "voice_01",
      "category": "在大廳點擊時I",
      "audio": "voices/voice_01.mp3",
      "text": "肚子餓就跟我說。\n我會邀請你來廚房。",
      "animation": "action"
    },
    {
      "id": "voice_02",
      "category": "在大廳點擊時I",
      "audio": "voices/voice_02.mp3",
      "text": "這冰淇淋，好硬啊。\n不過剛好適合慢慢舔著吃。舔舔——",
      "animation": "action"
    },
    {
      "id": "voice_03",
      "category": "在大廳點擊時II",
      "audio": "voices/voice_03.mp3",
      "text": "你有帶食物嗎？我可以吃一點嗎？",
      "animation": "action"
    },
    {
      "id": "voice_04",
      "category": "在大廳點擊時II",
      "audio": "voices/voice_04.mp3",
      "text": "甜甜的東西雖然吃不飽，\n但卻能讓人心情變好呢。\n美味要不要也吃一口？",
      "animation": "action"
    },
    {
      "id": "voice_05",
      "category": "在大廳點擊時III",
      "audio": "voices/voice_05.mp3",
      "text": "舔舔——舔——\n嗯～真好吃。",
      "animation": "action"
    },
    {
      "id": "voice_06",
      "category": "在大廳點擊時III",
      "audio": "voices/voice_06.mp3",
      "text": "吃太多甜的就好想睡……\n吃完冰淇淋，要不要一起睡個午覺？",
      "animation": "action"
    },
    {
      "id": "voice_07",
      "category": "在大廳點擊時（好感度10）I",
      "audio": "voices/voice_07.mp3",
      "text": "美味，今天看起來也很好吃呢。\n等等可以吃一口嗎？",
      "animation": "action"
    },
    {
      "id": "voice_08",
      "category": "在大廳點擊時（好感度10）I",
      "audio": "voices/voice_08.mp3",
      "text": "這個，可以塗在美味的手上嚐嚐看嗎？\n感覺一定會很甜呢。",
      "animation": "action"
    },
    {
      "id": "voice_09",
      "category": "在大廳點擊時（好感度10）II",
      "audio": "voices/voice_09.mp3",
      "text": "舔舔——怎麼了？手指頭很癢嗎？\n我想盡情品嚐美味，\n就再稍微忍耐一下吧。",
      "animation": "action"
    },
    {
      "id": "voice_10",
      "category": "在大廳點擊時（好感度10）II",
      "audio": "voices/voice_10.mp3",
      "text": "雖然甜點店也不錯……\n但我更想待在美味的房間。",
      "animation": "action"
    },
    {
      "id": "voice_11",
      "category": "在大廳點擊時（好感度10）III",
      "audio": "voices/voice_11.mp3",
      "text": "每次都只有我在吃，很不公平……\n美味要不要也舔舔我？",
      "animation": "action"
    },
    {
      "id": "voice_12",
      "category": "在大廳點擊時（好感度10）III",
      "audio": "voices/voice_12.mp3",
      "text": "甜點看著就賞心悅目，\n吃起來也讓人回味。\n……就像美味一樣。",
      "animation": "action"
    },
    {
      "id": "voice_13",
      "category": "在大廳閒置時",
      "audio": "voices/voice_13.mp3",
      "text": "……好餓。什麼時候才來呢？",
      "animation": "action"
    },
    {
      "id": "voice_14",
      "category": "在大廳閒置時",
      "audio": "voices/voice_14.mp3",
      "text": "好想吃甜甜的東西啊～\n冰淇淋、糖果、巧克力、可麗餅……",
      "animation": "action"
    },
    {
      "id": "voice_15",
      "category": "在大廳閒置時（好感度10）I",
      "audio": "voices/voice_15.mp3",
      "text": "一想到是在等美味，\n好像連餓肚子的感覺都變得有點值得享受了。",
      "animation": "shy"
    },
    {
      "id": "voice_16",
      "category": "在大廳閒置時（好感度10）I",
      "audio": "voices/voice_16.mp3",
      "text": "好想吃甜甜的東西啊～\n美味、美味、美味、美味……",
      "animation": "shy"
    },
    {
      "id": "voice_17",
      "category": "在前哨基地點擊I",
      "audio": "voices/voice_17.mp3",
      "text": "只有收到邀請的人才能進來我們的廚房。",
      "animation": "action"
    },
    {
      "id": "voice_18",
      "category": "在前哨基地點擊I",
      "audio": "voices/voice_18.mp3",
      "text": "你可以推薦不錯的甜點店給我嗎？",
      "animation": "action"
    },
    {
      "id": "voice_19",
      "category": "在前哨基地點擊II",
      "audio": "voices/voice_19.mp3",
      "text": "有帶好吃的東西來嗎？",
      "animation": "action"
    },
    {
      "id": "voice_20",
      "category": "在前哨基地點擊II",
      "audio": "voices/voice_20.mp3",
      "text": "我請克勞斯特準備了甜點喔。\n要不要一起去吃？",
      "animation": "action"
    },
    {
      "id": "voice_21",
      "category": "在前哨基地點擊III",
      "audio": "voices/voice_21.mp3",
      "text": "我正要去吃飯呢。\n我個人會推薦去女僕咖啡廳。",
      "animation": "action"
    },
    {
      "id": "voice_22",
      "category": "在前哨基地點擊III",
      "audio": "voices/voice_22.mp3",
      "text": "吃過飯了嗎？那，飯後甜點呢？",
      "animation": "action"
    },
    {
      "id": "voice_23",
      "category": "初次見面",
      "audio": "voices/voice_23.mp3",
      "text": "好餓啊，你有帶吃的東西嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_24",
      "category": "初次見面",
      "audio": "voices/voice_24.mp3",
      "text": "美味，我們一起去吃點甜的吧。",
      "animation": "idle"
    },
    {
      "id": "voice_25",
      "category": "戰鬥力提升I",
      "audio": "voices/voice_25.mp3",
      "text": "舌頭似乎變得更敏銳了。",
      "animation": "idle"
    },
    {
      "id": "voice_26",
      "category": "戰鬥力提升I",
      "audio": "voices/voice_26.mp3",
      "text": "肚子飽飽的～好像瞬間充滿力量了。",
      "animation": "idle"
    },
    {
      "id": "voice_27",
      "category": "戰鬥力提升II",
      "audio": "voices/voice_27.mp3",
      "text": "這種刺激的味道真有趣。",
      "animation": "idle"
    },
    {
      "id": "voice_28",
      "category": "戰鬥力提升II",
      "audio": "voices/voice_28.mp3",
      "text": "這樣似乎更能品嚐美味的味道呢。",
      "animation": "idle"
    },
    {
      "id": "voice_29",
      "category": "戰鬥力提升III",
      "audio": "voices/voice_29.mp3",
      "text": "肚子竟然有點飽了，真神奇。",
      "animation": "idle"
    },
    {
      "id": "voice_30",
      "category": "戰鬥力提升III",
      "audio": "voices/voice_30.mp3",
      "text": "舌頭變得刺刺～麻麻的。",
      "animation": "idle"
    },
    {
      "id": "voice_31",
      "category": "禮物I",
      "audio": "voices/voice_31.mp3",
      "text": "是什麼味道呢，真好奇。",
      "animation": "idle"
    },
    {
      "id": "voice_32",
      "category": "禮物I",
      "audio": "voices/voice_32.mp3",
      "text": "哇～我要開動了。",
      "animation": "idle"
    },
    {
      "id": "voice_33",
      "category": "禮物II",
      "audio": "voices/voice_33.mp3",
      "text": "謝謝，肚子餓時我會拿出來吃的。",
      "animation": "idle"
    },
    {
      "id": "voice_34",
      "category": "禮物II",
      "audio": "voices/voice_34.mp3",
      "text": "如果沾著冰淇淋吃，會變成什麼味道呢？",
      "animation": "idle"
    },
    {
      "id": "voice_35",
      "category": "禮物III",
      "audio": "voices/voice_35.mp3",
      "text": "給我食物的人就是好人。\n所以美味是好人。",
      "animation": "idle"
    },
    {
      "id": "voice_36",
      "category": "禮物III",
      "audio": "voices/voice_36.mp3",
      "text": "希望這個吃起來是甜甜的味道。",
      "animation": "idle"
    },
    {
      "id": "voice_37",
      "category": "好感度提升I",
      "audio": "voices/voice_37.mp3",
      "text": "美味，你一天比一天好吃呢。",
      "animation": "shy"
    },
    {
      "id": "voice_38",
      "category": "好感度提升I",
      "audio": "voices/voice_38.mp3",
      "text": "這麼甜的味道……還是第一次嚐到呢。",
      "animation": "shy"
    },
    {
      "id": "voice_39",
      "category": "好感度提升II",
      "audio": "voices/voice_39.mp3",
      "text": "下一道菜由美味親自餵我吧。啊啊～",
      "animation": "shy"
    },
    {
      "id": "voice_40",
      "category": "好感度提升II",
      "audio": "voices/voice_40.mp3",
      "text": "好喜歡美味。我可以舔你一下嗎……？",
      "animation": "shy"
    },
    {
      "id": "voice_41",
      "category": "好感度提升III",
      "audio": "voices/voice_41.mp3",
      "text": "原來光看就覺得飽是這種感覺啊。",
      "animation": "shy"
    },
    {
      "id": "voice_42",
      "category": "好感度提升III",
      "audio": "voices/voice_42.mp3",
      "text": "最近美味嚐起來都是甜甜的味道。\n這就是……所謂愛情的滋味嗎？",
      "animation": "shy"
    },
    {
      "id": "voice_43",
      "category": "編隊",
      "audio": "voices/voice_43.mp3",
      "text": "要吃什麼？",
      "animation": "idle"
    },
    {
      "id": "voice_44",
      "category": "編隊",
      "audio": "voices/voice_44.mp3",
      "text": "好，一起走吧。",
      "animation": "idle"
    },
    {
      "id": "voice_45",
      "category": "在野外點擊部隊",
      "audio": "voices/voice_45.mp3",
      "text": "嗯，叫我嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_46",
      "category": "在野外點擊部隊",
      "audio": "voices/voice_46.mp3",
      "text": "美味，你叫我嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_47",
      "category": "在野外移動部隊",
      "audio": "voices/voice_47.mp3",
      "text": "找到看起來很好吃的東西了。",
      "animation": "idle"
    },
    {
      "id": "voice_48",
      "category": "在野外移動部隊",
      "audio": "voices/voice_48.mp3",
      "text": "這裡有看起來甜甜的東西。",
      "animation": "idle"
    },
    {
      "id": "voice_49",
      "category": "進入戰鬥",
      "audio": "voices/voice_49.mp3",
      "text": "這裡的菜單看起來有點寒酸。",
      "animation": "idle"
    },
    {
      "id": "voice_50",
      "category": "進入戰鬥",
      "audio": "voices/voice_50.mp3",
      "text": "你們嚐起來會是什麼味道呢？",
      "animation": "idle"
    },
    {
      "id": "voice_51",
      "category": "開始戰鬥I",
      "audio": "voices/voice_51.mp3",
      "text": "全都是些看起來不好吃的東西呢。",
      "animation": "idle"
    },
    {
      "id": "voice_52",
      "category": "開始戰鬥I",
      "audio": "voices/voice_52.mp3",
      "text": "希望能嚐到新的味道呢……",
      "animation": "idle"
    },
    {
      "id": "voice_53",
      "category": "開始戰鬥II",
      "audio": "voices/voice_53.mp3",
      "text": "連塞牙縫都不夠。",
      "animation": "idle"
    },
    {
      "id": "voice_54",
      "category": "開始戰鬥II",
      "audio": "voices/voice_54.mp3",
      "text": "當主菜的話，應該沒問題吧？",
      "animation": "idle"
    },
    {
      "id": "voice_55",
      "category": "開始戰鬥III",
      "audio": "voices/voice_55.mp3",
      "text": "趕快處理完，去吃點好吃的吧。",
      "animation": "idle"
    },
    {
      "id": "voice_56",
      "category": "開始戰鬥III",
      "audio": "voices/voice_56.mp3",
      "text": "我來嚐一口看看。",
      "animation": "idle"
    },
    {
      "id": "voice_57",
      "category": "換彈I",
      "audio": "voices/voice_57.mp3",
      "text": "等等，消化一下。",
      "animation": "idle"
    },
    {
      "id": "voice_58",
      "category": "換彈I",
      "audio": "voices/voice_58.mp3",
      "text": "我擦一下嘴巴。",
      "animation": "idle"
    },
    {
      "id": "voice_59",
      "category": "換彈II",
      "audio": "voices/voice_59.mp3",
      "text": "……好想吃美食啊。",
      "animation": "idle"
    },
    {
      "id": "voice_60",
      "category": "換彈II",
      "audio": "voices/voice_60.mp3",
      "text": "……肚子好飽，好想睡。",
      "animation": "idle"
    },
    {
      "id": "voice_61",
      "category": "換彈III",
      "audio": "voices/voice_61.mp3",
      "text": "裝填中。",
      "animation": "idle"
    },
    {
      "id": "voice_62",
      "category": "換彈III",
      "audio": "voices/voice_62.mp3",
      "text": "舔舔～\n……槍好苦。",
      "animation": "idle"
    },
    {
      "id": "voice_63",
      "category": "可使用爆裂技能",
      "audio": "voices/voice_63.mp3",
      "text": "啊，好餓……！",
      "animation": "idle"
    },
    {
      "id": "voice_64",
      "category": "可使用爆裂技能",
      "audio": "voices/voice_64.mp3",
      "text": "咕嚕嚕。",
      "animation": "idle"
    },
    {
      "id": "voice_65",
      "category": "爆裂技能",
      "audio": "voices/voice_65.mp3",
      "text": "我會舔得乾乾淨淨。",
      "animation": "idle"
    },
    {
      "id": "voice_66",
      "category": "爆裂技能",
      "audio": "voices/voice_66.mp3",
      "text": "滿滿的甜點～",
      "animation": "idle"
    },
    {
      "id": "voice_67",
      "category": "全爆裂",
      "audio": "voices/voice_67.mp3",
      "text": "一起吃吧。",
      "animation": "idle"
    },
    {
      "id": "voice_68",
      "category": "全爆裂",
      "audio": "voices/voice_68.mp3",
      "text": "我要開動了。",
      "animation": "idle"
    },
    {
      "id": "voice_69",
      "category": "消滅敵人I",
      "audio": "voices/voice_69.mp3",
      "text": "再來一盤。",
      "animation": "idle"
    },
    {
      "id": "voice_70",
      "category": "消滅敵人I",
      "audio": "voices/voice_70.mp3",
      "text": "這個不太好吃。",
      "animation": "idle"
    },
    {
      "id": "voice_71",
      "category": "消滅敵人II",
      "audio": "voices/voice_71.mp3",
      "text": "試吃結束。",
      "animation": "idle"
    },
    {
      "id": "voice_72",
      "category": "消滅敵人II",
      "audio": "voices/voice_72.mp3",
      "text": "下一盤。",
      "animation": "idle"
    },
    {
      "id": "voice_73",
      "category": "消滅敵人III",
      "audio": "voices/voice_73.mp3",
      "text": "主菜，完食。",
      "animation": "idle"
    },
    {
      "id": "voice_74",
      "category": "消滅敵人III",
      "audio": "voices/voice_74.mp3",
      "text": "還有剩下的食物嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_75",
      "category": "被擊I",
      "audio": "voices/voice_75.mp3",
      "text": "唉唷。",
      "animation": "idle"
    },
    {
      "id": "voice_76",
      "category": "被擊I",
      "audio": "voices/voice_76.mp3",
      "text": "啊……！",
      "animation": "idle"
    },
    {
      "id": "voice_77",
      "category": "被擊II",
      "audio": "voices/voice_77.mp3",
      "text": "呃……！",
      "animation": "idle"
    },
    {
      "id": "voice_78",
      "category": "被擊II",
      "audio": "voices/voice_78.mp3",
      "text": "啊呀……！",
      "animation": "idle"
    },
    {
      "id": "voice_79",
      "category": "被擊III",
      "audio": "voices/voice_79.mp3",
      "text": "好痛……",
      "animation": "idle"
    },
    {
      "id": "voice_80",
      "category": "被擊III",
      "audio": "voices/voice_80.mp3",
      "text": "嗯……",
      "animation": "idle"
    },
    {
      "id": "voice_81",
      "category": "無法戰鬥",
      "audio": "voices/voice_81.mp3",
      "text": "呃……肚子餓，沒力氣了……",
      "animation": "idle"
    },
    {
      "id": "voice_82",
      "category": "無法戰鬥",
      "audio": "voices/voice_82.mp3",
      "text": "呃……糖分好像不夠了……",
      "animation": "idle"
    },
    {
      "id": "voice_83",
      "category": "戰鬥勝利",
      "audio": "voices/voice_83.mp3",
      "text": "我吃完了。下一道菜是什麼？",
      "animation": "idle"
    },
    {
      "id": "voice_84",
      "category": "戰鬥勝利",
      "audio": "voices/voice_84.mp3",
      "text": "甜點是專門留給另一個胃的，我們去吃甜甜的東西吧。",
      "animation": "idle"
    }
  ]
}