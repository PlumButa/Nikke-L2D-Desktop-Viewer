{
  "id": "343001",
  "resourceId": 430,
  "name": "諾伊斯",
  "skin": "預設",
  "spineVersion": "4.0",
  "skel": "c430_00.skel",
  "atlas": "c430_00.atlas",
  "defaultAnimation": "idle",
  "interactions": [
    {
      "id": "voice_01",
      "category": "在大廳點擊時I",
      "audio": "voices/voice_01.mp3",
      "text": "製作人，今天要先練習什麼？",
      "animation": "action"
    },
    {
      "id": "voice_02",
      "category": "在大廳點擊時I",
      "audio": "voices/voice_02.mp3",
      "text": "製作人，準備好觀看我的演出了嗎？",
      "animation": "action"
    },
    {
      "id": "voice_03",
      "category": "在大廳點擊時II",
      "audio": "voices/voice_03.mp3",
      "text": "今天的演出效果怎麼樣？……我有點擔心。",
      "animation": "action"
    },
    {
      "id": "voice_04",
      "category": "在大廳點擊時II",
      "audio": "voices/voice_04.mp3",
      "text": "呼……原以為準備這麼充足了不會有問題。但一想到要開演唱會，\n就有點緊張呢。",
      "animation": "action"
    },
    {
      "id": "voice_05",
      "category": "在大廳點擊時III",
      "audio": "voices/voice_05.mp3",
      "text": "我想提升自己的演出能力，\n還需要哪些練習呢？",
      "animation": "action"
    },
    {
      "id": "voice_06",
      "category": "在大廳點擊時III",
      "audio": "voices/voice_06.mp3",
      "text": "今天的現場演出\n也要好好替我加油喔，製作人。",
      "animation": "action"
    },
    {
      "id": "voice_07",
      "category": "在大廳點擊時（好感度10）I",
      "audio": "voices/voice_07.mp3",
      "text": "我想回看一下今天表演的片段。\n你能陪我嗎？",
      "animation": "action"
    },
    {
      "id": "voice_08",
      "category": "在大廳點擊時（好感度10）I",
      "audio": "voices/voice_08.mp3",
      "text": "過去的努力絕對不會辜負我，\n這次的演出我一定會綻放光彩。",
      "animation": "action"
    },
    {
      "id": "voice_09",
      "category": "在大廳點擊時（好感度10）II",
      "audio": "voices/voice_09.mp3",
      "text": "語氣……是不是也該練練呢……在你心中留下諾伊諾伊斯～！\n……好奇怪。",
      "animation": "action"
    },
    {
      "id": "voice_10",
      "category": "在大廳點擊時（好感度10）II",
      "audio": "voices/voice_10.mp3",
      "text": "無論登上什麼樣的舞台，\n想到有製作人陪我一起，我就不再感到害怕。",
      "animation": "action"
    },
    {
      "id": "voice_11",
      "category": "在大廳點擊時（好感度10）III",
      "audio": "voices/voice_11.mp3",
      "text": "我想離我的聽眾更近一些。\n製作人，你會幫我的，對不對？",
      "animation": "action"
    },
    {
      "id": "voice_12",
      "category": "在大廳點擊時（好感度10）III",
      "audio": "voices/voice_12.mp3",
      "text": "今天的演唱會是為製作人準備的。\n一定要來呀。",
      "animation": "action"
    },
    {
      "id": "voice_13",
      "category": "在大廳閒置時",
      "audio": "voices/voice_13.mp3",
      "text": "沒什麼事情的話，我可以去練歌嗎？",
      "animation": "action"
    },
    {
      "id": "voice_14",
      "category": "在大廳閒置時",
      "audio": "voices/voice_14.mp3",
      "text": "嗯……我得去準備現場演出了，\n可以先走一步嗎？",
      "animation": "action"
    },
    {
      "id": "voice_15",
      "category": "在大廳閒置時（好感度10）I",
      "audio": "voices/voice_15.mp3",
      "text": "就這樣用大腦放空的狀態待命……\n好像也不賴呢。",
      "animation": "shy"
    },
    {
      "id": "voice_16",
      "category": "在大廳閒置時（好感度10）I",
      "audio": "voices/voice_16.mp3",
      "text": "在製作人旁邊，感覺接收到了好運。\n我覺得今天會萬事順遂。",
      "animation": "shy"
    },
    {
      "id": "voice_17",
      "category": "在前哨基地點擊I",
      "audio": "voices/voice_17.mp3",
      "text": "今天我會與沃綸姆和阿莉亞一起在劇院演出，\n你要不要來看？",
      "animation": "action"
    },
    {
      "id": "voice_18",
      "category": "在前哨基地點擊I",
      "audio": "voices/voice_18.mp3",
      "text": "我想在劇院進行演唱會的彩排……\n你要來看嗎？",
      "animation": "action"
    },
    {
      "id": "voice_19",
      "category": "在前哨基地點擊II",
      "audio": "voices/voice_19.mp3",
      "text": "這裡的劇院什麼都好，就是沒有觀眾。\n所以……製作人你能當我的觀眾嗎？",
      "animation": "action"
    },
    {
      "id": "voice_20",
      "category": "在前哨基地點擊II",
      "audio": "voices/voice_20.mp3",
      "text": "不管我在哪裡，製作人好像都能找到我。\n所以……我很開心。",
      "animation": "action"
    },
    {
      "id": "voice_21",
      "category": "在前哨基地點擊III",
      "audio": "voices/voice_21.mp3",
      "text": "這裡真是太好了。我覺得……這裡比方舟更自由，\n很適合做音樂。",
      "animation": "action"
    },
    {
      "id": "voice_22",
      "category": "在前哨基地點擊III",
      "audio": "voices/voice_22.mp3",
      "text": "想起了在前哨基地練習的那段時光。\n應該是那些時光成就了現在的我吧？",
      "animation": "action"
    },
    {
      "id": "voice_23",
      "category": "初次見面",
      "audio": "voices/voice_23.mp3",
      "text": "製作人，你能聽一下我的歌嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_24",
      "category": "初次見面",
      "audio": "voices/voice_24.mp3",
      "text": "我很高興能夠站在更大的舞台上。\n這次也請多多關照，製作人。",
      "animation": "idle"
    },
    {
      "id": "voice_25",
      "category": "戰鬥力提升I",
      "audio": "voices/voice_25.mp3",
      "text": "謝謝你的關心。",
      "animation": "idle"
    },
    {
      "id": "voice_26",
      "category": "戰鬥力提升I",
      "audio": "voices/voice_26.mp3",
      "text": "我會把它當成是對我的激勵。",
      "animation": "idle"
    },
    {
      "id": "voice_27",
      "category": "戰鬥力提升II",
      "audio": "voices/voice_27.mp3",
      "text": "你製作得很好。",
      "animation": "idle"
    },
    {
      "id": "voice_28",
      "category": "戰鬥力提升II",
      "audio": "voices/voice_28.mp3",
      "text": "謝謝你的支持。",
      "animation": "idle"
    },
    {
      "id": "voice_29",
      "category": "戰鬥力提升III",
      "audio": "voices/voice_29.mp3",
      "text": "我是不是成長了一些？",
      "animation": "idle"
    },
    {
      "id": "voice_30",
      "category": "戰鬥力提升III",
      "audio": "voices/voice_30.mp3",
      "text": "我感覺可以挑戰更高的音域了。",
      "animation": "idle"
    },
    {
      "id": "voice_31",
      "category": "禮物I",
      "audio": "voices/voice_31.mp3",
      "text": "突然送我禮物？……謝謝。",
      "animation": "idle"
    },
    {
      "id": "voice_32",
      "category": "禮物I",
      "audio": "voices/voice_32.mp3",
      "text": "下次我也會為你準備禮物。",
      "animation": "idle"
    },
    {
      "id": "voice_33",
      "category": "禮物II",
      "audio": "voices/voice_33.mp3",
      "text": "原來……製作人也是我的粉絲？",
      "animation": "idle"
    },
    {
      "id": "voice_34",
      "category": "禮物II",
      "audio": "voices/voice_34.mp3",
      "text": "你那麼忙，怎麼有時間準備禮物呀？\n真是太感激了。",
      "animation": "idle"
    },
    {
      "id": "voice_35",
      "category": "禮物III",
      "audio": "voices/voice_35.mp3",
      "text": "我會好好珍藏的。",
      "animation": "idle"
    },
    {
      "id": "voice_36",
      "category": "禮物III",
      "audio": "voices/voice_36.mp3",
      "text": "你怎麼會送我這個……！\n我幾天前就希望有這麼一件東西了……好感動。",
      "animation": "idle"
    },
    {
      "id": "voice_37",
      "category": "好感度提升I",
      "audio": "voices/voice_37.mp3",
      "text": "除了創作歌手之外……\n能為我打造全新的身分嗎？",
      "animation": "shy"
    },
    {
      "id": "voice_38",
      "category": "好感度提升I",
      "audio": "voices/voice_38.mp3",
      "text": "雖然現在我的自信心有了不小的提升……\n但我依然需要製作人。",
      "animation": "shy"
    },
    {
      "id": "voice_39",
      "category": "好感度提升II",
      "audio": "voices/voice_39.mp3",
      "text": "總有一天……我會為製作人寫首歌的。",
      "animation": "shy"
    },
    {
      "id": "voice_40",
      "category": "好感度提升II",
      "audio": "voices/voice_40.mp3",
      "text": "總有一天，我會讓你因為聽了我的歌而心動。",
      "animation": "shy"
    },
    {
      "id": "voice_41",
      "category": "好感度提升III",
      "audio": "voices/voice_41.mp3",
      "text": "最近一看到製作人就會心跳加速。\n希望製作人也和我有一樣的感覺。",
      "animation": "shy"
    },
    {
      "id": "voice_42",
      "category": "好感度提升III",
      "audio": "voices/voice_42.mp3",
      "text": "沒有製作人的支持，就不會有今天的我。\n以後也請多多關照。",
      "animation": "shy"
    },
    {
      "id": "voice_43",
      "category": "編隊",
      "audio": "voices/voice_43.mp3",
      "text": "輪到我了。",
      "animation": "idle"
    },
    {
      "id": "voice_44",
      "category": "編隊",
      "audio": "voices/voice_44.mp3",
      "text": "我準備好了。走吧。",
      "animation": "idle"
    },
    {
      "id": "voice_45",
      "category": "在野外點擊部隊",
      "audio": "voices/voice_45.mp3",
      "text": "嗯，我在聽。",
      "animation": "idle"
    },
    {
      "id": "voice_46",
      "category": "在野外點擊部隊",
      "audio": "voices/voice_46.mp3",
      "text": "說吧。",
      "animation": "idle"
    },
    {
      "id": "voice_47",
      "category": "在野外移動部隊",
      "audio": "voices/voice_47.mp3",
      "text": "好，開始移動。",
      "animation": "idle"
    },
    {
      "id": "voice_48",
      "category": "在野外移動部隊",
      "audio": "voices/voice_48.mp3",
      "text": "嗯，讓我去那邊是吧？",
      "animation": "idle"
    },
    {
      "id": "voice_49",
      "category": "進入戰鬥",
      "audio": "voices/voice_49.mp3",
      "text": "現在是唱歌時間。",
      "animation": "idle"
    },
    {
      "id": "voice_50",
      "category": "進入戰鬥",
      "audio": "voices/voice_50.mp3",
      "text": "呼……現場演出開始了。",
      "animation": "idle"
    },
    {
      "id": "voice_51",
      "category": "開始戰鬥I",
      "audio": "voices/voice_51.mp3",
      "text": "讓我的歌聲在這裡響起吧。",
      "animation": "idle"
    },
    {
      "id": "voice_52",
      "category": "開始戰鬥I",
      "audio": "voices/voice_52.mp3",
      "text": "讓我們愉快地戰勝這次現場演出吧。",
      "animation": "idle"
    },
    {
      "id": "voice_53",
      "category": "開始戰鬥II",
      "audio": "voices/voice_53.mp3",
      "text": "我會努力的。",
      "animation": "idle"
    },
    {
      "id": "voice_54",
      "category": "開始戰鬥II",
      "audio": "voices/voice_54.mp3",
      "text": "有製作人陪在我身邊，我做得到。",
      "animation": "idle"
    },
    {
      "id": "voice_55",
      "category": "開始戰鬥III",
      "audio": "voices/voice_55.mp3",
      "text": "不管迎來什麼樣的觀眾，我都不會輸。",
      "animation": "idle"
    },
    {
      "id": "voice_56",
      "category": "開始戰鬥III",
      "audio": "voices/voice_56.mp3",
      "text": "我會試著唱出打動觀眾內心的歌曲。",
      "animation": "idle"
    },
    {
      "id": "voice_57",
      "category": "換彈I",
      "audio": "voices/voice_57.mp3",
      "text": "呼……我休息一下就好。",
      "animation": "idle"
    },
    {
      "id": "voice_58",
      "category": "換彈I",
      "audio": "voices/voice_58.mp3",
      "text": "呼……別擔心，我還不累。",
      "animation": "idle"
    },
    {
      "id": "voice_59",
      "category": "換彈II",
      "audio": "voices/voice_59.mp3",
      "text": "我還能撐一下。",
      "animation": "idle"
    },
    {
      "id": "voice_60",
      "category": "換彈II",
      "audio": "voices/voice_60.mp3",
      "text": "我可以的。再加把勁……！",
      "animation": "idle"
    },
    {
      "id": "voice_61",
      "category": "換彈III",
      "audio": "voices/voice_61.mp3",
      "text": "我喘口氣再走。",
      "animation": "idle"
    },
    {
      "id": "voice_62",
      "category": "換彈III",
      "audio": "voices/voice_62.mp3",
      "text": "再打起精神……走吧。",
      "animation": "idle"
    },
    {
      "id": "voice_63",
      "category": "可使用爆裂技能",
      "audio": "voices/voice_63.mp3",
      "text": "製作人！",
      "animation": "idle"
    },
    {
      "id": "voice_64",
      "category": "可使用爆裂技能",
      "audio": "voices/voice_64.mp3",
      "text": "製作人！",
      "animation": "idle"
    },
    {
      "id": "voice_65",
      "category": "爆裂技能",
      "audio": "voices/voice_65.mp3",
      "text": "諾伊斯的歌聲永不停歇！讓我們一起唱！",
      "animation": "idle"
    },
    {
      "id": "voice_66",
      "category": "爆裂技能",
      "audio": "voices/voice_66.mp3",
      "text": "在閃耀的舞台上，\n為你而存在的Noise！",
      "animation": "idle"
    },
    {
      "id": "voice_67",
      "category": "全爆裂",
      "audio": "voices/voice_67.mp3",
      "text": "我們一起唱！",
      "animation": "idle"
    },
    {
      "id": "voice_68",
      "category": "全爆裂",
      "audio": "voices/voice_68.mp3",
      "text": "大家加油！唱到最後！",
      "animation": "idle"
    },
    {
      "id": "voice_69",
      "category": "消滅敵人I",
      "audio": "voices/voice_69.mp3",
      "text": "再來一首！",
      "animation": "idle"
    },
    {
      "id": "voice_70",
      "category": "消滅敵人I",
      "audio": "voices/voice_70.mp3",
      "text": "很好，下一首！",
      "animation": "idle"
    },
    {
      "id": "voice_71",
      "category": "消滅敵人II",
      "audio": "voices/voice_71.mp3",
      "text": "很好！",
      "animation": "idle"
    },
    {
      "id": "voice_72",
      "category": "消滅敵人II",
      "audio": "voices/voice_72.mp3",
      "text": "感覺不錯呢！",
      "animation": "idle"
    },
    {
      "id": "voice_73",
      "category": "消滅敵人III",
      "audio": "voices/voice_73.mp3",
      "text": "我做到了！",
      "animation": "idle"
    },
    {
      "id": "voice_74",
      "category": "消滅敵人III",
      "audio": "voices/voice_74.mp3",
      "text": "要繼續嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_75",
      "category": "被擊I",
      "audio": "voices/voice_75.mp3",
      "text": "呃。",
      "animation": "idle"
    },
    {
      "id": "voice_76",
      "category": "被擊I",
      "audio": "voices/voice_76.mp3",
      "text": "呃。",
      "animation": "idle"
    },
    {
      "id": "voice_77",
      "category": "被擊II",
      "audio": "voices/voice_77.mp3",
      "text": "唔。",
      "animation": "idle"
    },
    {
      "id": "voice_78",
      "category": "被擊II",
      "audio": "voices/voice_78.mp3",
      "text": "我要……穩住……",
      "animation": "idle"
    },
    {
      "id": "voice_79",
      "category": "被擊III",
      "audio": "voices/voice_79.mp3",
      "text": "啊。",
      "animation": "idle"
    },
    {
      "id": "voice_80",
      "category": "被擊III",
      "audio": "voices/voice_80.mp3",
      "text": "啊！",
      "animation": "idle"
    },
    {
      "id": "voice_81",
      "category": "無法戰鬥",
      "audio": "voices/voice_81.mp3",
      "text": "對不起……製作人……我的能力只能做到這樣了。",
      "animation": "idle"
    },
    {
      "id": "voice_82",
      "category": "無法戰鬥",
      "audio": "voices/voice_82.mp3",
      "text": "現場演出……還沒結束……不行……",
      "animation": "idle"
    },
    {
      "id": "voice_83",
      "category": "戰鬥勝利",
      "audio": "voices/voice_83.mp3",
      "text": "我的表演怎麼樣？還可以嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_84",
      "category": "戰鬥勝利",
      "audio": "voices/voice_84.mp3",
      "text": "這次的現場演出也非常成功！",
      "animation": "idle"
    }
  ]
}