{
  "id": "141201",
  "resourceId": 412,
  "name": "特蕾娜",
  "skin": "預設",
  "spineVersion": "4.0",
  "skel": "c412_00.skel",
  "atlas": "c412_00.atlas",
  "defaultAnimation": "idle",
  "interactions": [
    {
      "id": "voice_01",
      "category": "在大廳點擊時I",
      "audio": "voices/voice_01.mp3",
      "text": "您很好奇我頭上的孩子們嗎？\n呵呵，他們是我珍貴的家人。",
      "animation": "action"
    },
    {
      "id": "voice_02",
      "category": "在大廳點擊時II",
      "audio": "voices/voice_02.mp3",
      "text": "您聽到大自然的聲音了嗎？",
      "animation": "action"
    },
    {
      "id": "voice_03",
      "category": "在大廳點擊時III",
      "audio": "voices/voice_03.mp3",
      "text": "雖然樹木看起來粗枝大葉又遲鈍，\n但其實他們也需要細膩的關懷。",
      "animation": "action"
    },
    {
      "id": "voice_04",
      "category": "在大廳點擊時（好感度10）I",
      "audio": "voices/voice_04.mp3",
      "text": "如果您累了，可以到我懷裡休息～",
      "animation": "action"
    },
    {
      "id": "voice_05",
      "category": "在大廳點擊時（好感度10）II",
      "audio": "voices/voice_05.mp3",
      "text": "這股令人陶醉的芬多精香氣是……\n哎呀，原來是太陽先生來啦！",
      "animation": "action"
    },
    {
      "id": "voice_06",
      "category": "在大廳點擊時（好感度10）III",
      "audio": "voices/voice_06.mp3",
      "text": "脫掉衣服，試著貼近大自然吧～\n太陽先生要一起脫嗎？",
      "animation": "action"
    },
    {
      "id": "voice_07",
      "category": "在大廳閒置時",
      "audio": "voices/voice_07.mp3",
      "text": "哎呀，太陽先生，您去哪裡了？\n哦～難道有您認識的朋友嗎？",
      "animation": "action"
    },
    {
      "id": "voice_08",
      "category": "在大廳閒置時（好感度10）I",
      "audio": "voices/voice_08.mp3",
      "text": "不用著急，慢慢來就好～\n因為我的懷抱永遠為您敞開～",
      "animation": "shy"
    },
    {
      "id": "voice_09",
      "category": "在前哨基地點擊I",
      "audio": "voices/voice_09.mp3",
      "text": "我想總有一天，這裡的所有人\n都可以感受到自然的美麗，對不對？",
      "animation": "action"
    },
    {
      "id": "voice_10",
      "category": "在前哨基地點擊II",
      "audio": "voices/voice_10.mp3",
      "text": "竟然能在人工環境下茁壯成長～\n生命確實偉大。",
      "animation": "action"
    },
    {
      "id": "voice_11",
      "category": "在前哨基地點擊III",
      "audio": "voices/voice_11.mp3",
      "text": "這裡也有很多孩子需要我的幫助～",
      "animation": "action"
    },
    {
      "id": "voice_12",
      "category": "初次見面",
      "audio": "voices/voice_12.mp3",
      "text": "我是負責照管樹木的特蕾娜。\n我的懷抱隨時向您敞開。",
      "animation": "idle"
    },
    {
      "id": "voice_13",
      "category": "戰鬥力提升I",
      "audio": "voices/voice_13.mp3",
      "text": "距離自然又近了一步～\n我可以脫掉衣服，在這裡散散步嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_14",
      "category": "戰鬥力提升II",
      "audio": "voices/voice_14.mp3",
      "text": "哇～感覺自己充滿了生命力～",
      "animation": "idle"
    },
    {
      "id": "voice_15",
      "category": "戰鬥力提升III",
      "audio": "voices/voice_15.mp3",
      "text": "孩子們～記得跟太陽先生說謝謝噢。",
      "animation": "idle"
    },
    {
      "id": "voice_16",
      "category": "禮物I",
      "audio": "voices/voice_16.mp3",
      "text": "哇～這是送我的禮物嗎？\n我很久沒收到禮物了呢，謝謝您，我很感動～",
      "animation": "idle"
    },
    {
      "id": "voice_17",
      "category": "禮物II",
      "audio": "voices/voice_17.mp3",
      "text": "您無私付出的樣子 ……\n感覺就像一棵蘋果樹？",
      "animation": "idle"
    },
    {
      "id": "voice_18",
      "category": "禮物III",
      "audio": "voices/voice_18.mp3",
      "text": "嘿嘿，謝謝您～\n哎呀，你們也喜歡嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_19",
      "category": "好感度提升I",
      "audio": "voices/voice_19.mp3",
      "text": "太陽先生……我可以抱抱您嗎？",
      "animation": "shy"
    },
    {
      "id": "voice_20",
      "category": "好感度提升II",
      "audio": "voices/voice_20.mp3",
      "text": "太陽先生的身體與心靈……\n比我見過的任何樹都堅強。",
      "animation": "shy"
    },
    {
      "id": "voice_21",
      "category": "好感度提升III",
      "audio": "voices/voice_21.mp3",
      "text": "好想獨佔這抹照亮所有人的陽光……\n這就是慾望嗎？",
      "animation": "shy"
    },
    {
      "id": "voice_22",
      "category": "編隊",
      "audio": "voices/voice_22.mp3",
      "text": "好啊～要去行光合作用嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_23",
      "category": "在野外點擊部隊",
      "audio": "voices/voice_23.mp3",
      "text": "哎呀，您叫我嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_24",
      "category": "在野外移動部隊",
      "audio": "voices/voice_24.mp3",
      "text": "不知道這周遭會有哪些孩子的蹤影呢？",
      "animation": "idle"
    },
    {
      "id": "voice_25",
      "category": "進入戰鬥",
      "audio": "voices/voice_25.mp3",
      "text": "終於可以回歸自然了～",
      "animation": "idle"
    },
    {
      "id": "voice_26",
      "category": "開始戰鬥I",
      "audio": "voices/voice_26.mp3",
      "text": "您是不是找錯地方扎根了？",
      "animation": "idle"
    },
    {
      "id": "voice_27",
      "category": "開始戰鬥II",
      "audio": "voices/voice_27.mp3",
      "text": "我要砍掉您多餘的樹枝～",
      "animation": "idle"
    },
    {
      "id": "voice_28",
      "category": "開始戰鬥III",
      "audio": "voices/voice_28.mp3",
      "text": "小心點～不要傷到孩子們～",
      "animation": "idle"
    },
    {
      "id": "voice_29",
      "category": "換彈I",
      "audio": "voices/voice_29.mp3",
      "text": "小心，欲速則不達哦～",
      "animation": "idle"
    },
    {
      "id": "voice_30",
      "category": "換彈II",
      "audio": "voices/voice_30.mp3",
      "text": "輕一點，不要傷到根莖……",
      "animation": "idle"
    },
    {
      "id": "voice_31",
      "category": "換彈III",
      "audio": "voices/voice_31.mp3",
      "text": "嘿嘿，小心點喔～",
      "animation": "idle"
    },
    {
      "id": "voice_32",
      "category": "可使用爆裂技能",
      "audio": "voices/voice_32.mp3",
      "text": "大自然在召喚我們！",
      "animation": "idle"
    },
    {
      "id": "voice_33",
      "category": "爆裂技能",
      "audio": "voices/voice_33.mp3",
      "text": "大自然……很美。",
      "animation": "idle"
    },
    {
      "id": "voice_34",
      "category": "全爆裂",
      "audio": "voices/voice_34.mp3",
      "text": "感受一下滿滿的生命力吧！",
      "animation": "idle"
    },
    {
      "id": "voice_35",
      "category": "消滅敵人I",
      "audio": "voices/voice_35.mp3",
      "text": "這會成為優質肥料的。",
      "animation": "idle"
    },
    {
      "id": "voice_36",
      "category": "消滅敵人II",
      "audio": "voices/voice_36.mp3",
      "text": "您的根壞了嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_37",
      "category": "消滅敵人III",
      "audio": "voices/voice_37.mp3",
      "text": "回土裡去吧～",
      "animation": "idle"
    },
    {
      "id": "voice_38",
      "category": "被擊I",
      "audio": "voices/voice_38.mp3",
      "text": "好、好痛……",
      "animation": "idle"
    },
    {
      "id": "voice_39",
      "category": "被擊II",
      "audio": "voices/voice_39.mp3",
      "text": "呃！",
      "animation": "idle"
    },
    {
      "id": "voice_40",
      "category": "被擊III",
      "audio": "voices/voice_40.mp3",
      "text": "哎呀……",
      "animation": "idle"
    },
    {
      "id": "voice_41",
      "category": "無法戰鬥",
      "audio": "voices/voice_41.mp3",
      "text": "呃啊……這很不自然……",
      "animation": "idle"
    },
    {
      "id": "voice_42",
      "category": "戰鬥勝利",
      "audio": "voices/voice_42.mp3",
      "text": "嘿嘿……終於結出果實了～",
      "animation": "idle"
    }
  ]
}