{
  "id": "232101",
  "resourceId": 321,
  "name": "瑪律恰那",
  "skin": "學生時代",
  "spineVersion": "4.0",
  "skel": "c321_01_00.skel",
  "atlas": "c321_01_00.atlas",
  "defaultAnimation": "idle",
  "interactions": [
    {
      "id": "voice_01",
      "category": "在大廳點擊時I",
      "audio": "voices/voice_01.mp3",
      "text": "身為教師，理解學生是件重要的事。",
      "animation": "action"
    },
    {
      "id": "voice_02",
      "category": "在大廳點擊時I",
      "audio": "voices/voice_02.mp3",
      "text": "那麼開始上課……哎呀。\n現在我是學生。",
      "animation": "action"
    },
    {
      "id": "voice_03",
      "category": "在大廳點擊時II",
      "audio": "voices/voice_03.mp3",
      "text": "指揮官大人，您有什麼疑問嗎？",
      "animation": "action"
    },
    {
      "id": "voice_04",
      "category": "在大廳點擊時II",
      "audio": "voices/voice_04.mp3",
      "text": "指揮官大人……哦不，老師。\n這麼稱呼您有點不好意思呢。",
      "animation": "action"
    },
    {
      "id": "voice_05",
      "category": "在大廳點擊時III",
      "audio": "voices/voice_05.mp3",
      "text": "改完考卷後，還要準備綜合評分、學生的個人面談……\n之後要進行最新引進課程的試行。",
      "animation": "action"
    },
    {
      "id": "voice_06",
      "category": "在大廳點擊時III",
      "audio": "voices/voice_06.mp3",
      "text": "今天您要講什麼課呢？",
      "animation": "action"
    },
    {
      "id": "voice_07",
      "category": "在大廳點擊時（好感度10）I",
      "audio": "voices/voice_07.mp3",
      "text": "……指揮官大人。如果您今天要去學校的話，要不要一起去呢？",
      "animation": "action"
    },
    {
      "id": "voice_08",
      "category": "在大廳點擊時（好感度10）I",
      "audio": "voices/voice_08.mp3",
      "text": "沒想到校服這麼不舒服。\n好像太緊了。",
      "animation": "action"
    },
    {
      "id": "voice_09",
      "category": "在大廳點擊時（好感度10）II",
      "audio": "voices/voice_09.mp3",
      "text": "最近很流行貓咪櫻桃蛋糕。\n……為了更瞭解學生，\n有必要嚐嚐看。",
      "animation": "action"
    },
    {
      "id": "voice_10",
      "category": "在大廳點擊時（好感度10）II",
      "audio": "voices/voice_10.mp3",
      "text": "老師……這部分我不太明白。\n能為我講解嗎？",
      "animation": "action"
    },
    {
      "id": "voice_11",
      "category": "在大廳點擊時（好感度10）III",
      "audio": "voices/voice_11.mp3",
      "text": "再加購Lovely Sweets的雜誌……\n……啊，我是為了瞭解學生們關心的話題才購買的。",
      "animation": "action"
    },
    {
      "id": "voice_12",
      "category": "在大廳點擊時（好感度10）III",
      "audio": "voices/voice_12.mp3",
      "text": "竟然是一對一單獨授課。我有點緊張。",
      "animation": "action"
    },
    {
      "id": "voice_13",
      "category": "在大廳閒置時",
      "audio": "voices/voice_13.mp3",
      "text": "那我就去改考卷了。",
      "animation": "action"
    },
    {
      "id": "voice_14",
      "category": "在大廳閒置時",
      "audio": "voices/voice_14.mp3",
      "text": "您放心去吧。我會在這裡複習的。",
      "animation": "action"
    },
    {
      "id": "voice_15",
      "category": "在大廳閒置時（好感度10）I",
      "audio": "voices/voice_15.mp3",
      "text": "……指揮官大人，您還在忙嗎？",
      "animation": "shy-1"
    },
    {
      "id": "voice_16",
      "category": "在大廳閒置時（好感度10）I",
      "audio": "voices/voice_16.mp3",
      "text": "老師，您很忙嗎？\n我穿成這樣一個人待在這裡，有點害羞……\n不，是有點尷尬呢。",
      "animation": "shy-1"
    },
    {
      "id": "voice_17",
      "category": "在前哨基地點擊I",
      "audio": "voices/voice_17.mp3",
      "text": "教師可不分場合。\n如果有什麼問題，可以隨時提出來。",
      "animation": "action"
    },
    {
      "id": "voice_18",
      "category": "在前哨基地點擊I",
      "audio": "voices/voice_18.mp3",
      "text": "不、不會碰到學生吧？",
      "animation": "action"
    },
    {
      "id": "voice_19",
      "category": "在前哨基地點擊II",
      "audio": "voices/voice_19.mp3",
      "text": "……指揮官大人？ \n我準備去圖書館收集資料。",
      "animation": "action"
    },
    {
      "id": "voice_20",
      "category": "在前哨基地點擊II",
      "audio": "voices/voice_20.mp3",
      "text": "我會服從指揮……不對。\n我會聽從老師的指導。",
      "animation": "action"
    },
    {
      "id": "voice_21",
      "category": "在前哨基地點擊III",
      "audio": "voices/voice_21.mp3",
      "text": "在這裡散步的時候，內心總是會感到平靜。",
      "animation": "action"
    },
    {
      "id": "voice_22",
      "category": "在前哨基地點擊III",
      "audio": "voices/voice_22.mp3",
      "text": "沒想到穿運動鞋\n活動起來這麼舒服。",
      "animation": "action"
    },
    {
      "id": "voice_23",
      "category": "初次見面",
      "audio": "voices/voice_23.mp3",
      "text": "我是M.M.R.附屬高中的教師瑪律恰那。\n我會努力上好每一節課。",
      "animation": "idle"
    },
    {
      "id": "voice_24",
      "category": "初次見面",
      "audio": "voices/voice_24.mp3",
      "text": "雖然只有一天，\n但我想從老師這裡學習很多東西。",
      "animation": "idle"
    },
    {
      "id": "voice_25",
      "category": "戰鬥力提升I",
      "audio": "voices/voice_25.mp3",
      "text": "感覺教學時能更加得心應手了。",
      "animation": "idle"
    },
    {
      "id": "voice_26",
      "category": "戰鬥力提升I",
      "audio": "voices/voice_26.mp3",
      "text": "長知識了。",
      "animation": "idle"
    },
    {
      "id": "voice_27",
      "category": "戰鬥力提升II",
      "audio": "voices/voice_27.mp3",
      "text": "備課時間似乎能縮短了。",
      "animation": "idle"
    },
    {
      "id": "voice_28",
      "category": "戰鬥力提升II",
      "audio": "voices/voice_28.mp3",
      "text": "原來還有這樣的教學方法。真棒！",
      "animation": "idle"
    },
    {
      "id": "voice_29",
      "category": "戰鬥力提升III",
      "audio": "voices/voice_29.mp3",
      "text": "我會準備全新的課程。",
      "animation": "idle"
    },
    {
      "id": "voice_30",
      "category": "戰鬥力提升III",
      "audio": "voices/voice_30.mp3",
      "text": "指揮官……不，\n老師的授課讓我受益匪淺。謝謝您。",
      "animation": "idle"
    },
    {
      "id": "voice_31",
      "category": "禮物I",
      "audio": "voices/voice_31.mp3",
      "text": "……謝謝您的禮物，指揮官大人。",
      "animation": "idle"
    },
    {
      "id": "voice_32",
      "category": "禮物I",
      "audio": "voices/voice_32.mp3",
      "text": "我真的可以收下這麼好的禮物嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_33",
      "category": "禮物II",
      "audio": "voices/voice_33.mp3",
      "text": "……總覺得能教學生更多事了。",
      "animation": "idle"
    },
    {
      "id": "voice_34",
      "category": "禮物II",
      "audio": "voices/voice_34.mp3",
      "text": "老師好溫柔。",
      "animation": "idle"
    },
    {
      "id": "voice_35",
      "category": "禮物III",
      "audio": "voices/voice_35.mp3",
      "text": "是為我準備的嗎？ ……我很開心，指揮官大人。",
      "animation": "idle"
    },
    {
      "id": "voice_36",
      "category": "禮物III",
      "audio": "voices/voice_36.mp3",
      "text": "我好高興……指揮官大人……\n哦，不對。是老師。",
      "animation": "idle"
    },
    {
      "id": "voice_37",
      "category": "好感度提升I",
      "audio": "voices/voice_37.mp3",
      "text": "……指揮官大人，一直以來都很感謝您。",
      "animation": "shy-1"
    },
    {
      "id": "voice_38",
      "category": "好感度提升I",
      "audio": "voices/voice_38.mp3",
      "text": "我一直很尊敬您。",
      "animation": "shy-1"
    },
    {
      "id": "voice_39",
      "category": "好感度提升II",
      "audio": "voices/voice_39.mp3",
      "text": "多虧了指揮官大人，感覺自己的見識越來越廣了。",
      "animation": "shy-1"
    },
    {
      "id": "voice_40",
      "category": "好感度提升II",
      "audio": "voices/voice_40.mp3",
      "text": "我可以多依賴您一點嗎？",
      "animation": "shy-1"
    },
    {
      "id": "voice_41",
      "category": "好感度提升III",
      "audio": "voices/voice_41.mp3",
      "text": "……指揮官大人，您今後也會一直陪伴我嗎？",
      "animation": "shy-1"
    },
    {
      "id": "voice_42",
      "category": "好感度提升III",
      "audio": "voices/voice_42.mp3",
      "text": "多虧了老師，\n我能理解學生們的心情了。\n……我怎麼有點緊張呢。",
      "animation": "shy-1"
    },
    {
      "id": "voice_43",
      "category": "編隊",
      "audio": "voices/voice_43.mp3",
      "text": "需要上課嗎，指揮官大人？",
      "animation": "idle"
    },
    {
      "id": "voice_44",
      "category": "編隊",
      "audio": "voices/voice_44.mp3",
      "text": "我會與您並肩作戰的，指揮官大人。\n不對，是老師。",
      "animation": "idle"
    },
    {
      "id": "voice_45",
      "category": "在野外點擊部隊",
      "audio": "voices/voice_45.mp3",
      "text": "我準備好了。",
      "animation": "idle"
    },
    {
      "id": "voice_46",
      "category": "在野外點擊部隊",
      "audio": "voices/voice_46.mp3",
      "text": "嗯，您叫我？",
      "animation": "idle"
    },
    {
      "id": "voice_47",
      "category": "在野外移動部隊",
      "audio": "voices/voice_47.mp3",
      "text": "好的，我這就出發。",
      "animation": "idle"
    },
    {
      "id": "voice_48",
      "category": "在野外移動部隊",
      "audio": "voices/voice_48.mp3",
      "text": "我會跟隨您。",
      "animation": "idle"
    },
    {
      "id": "voice_49",
      "category": "進入戰鬥",
      "audio": "voices/voice_49.mp3",
      "text": "可以開始了嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_50",
      "category": "進入戰鬥",
      "audio": "voices/voice_50.mp3",
      "text": "我準備好戰鬥了。",
      "animation": "idle"
    },
    {
      "id": "voice_51",
      "category": "開始戰鬥I",
      "audio": "voices/voice_51.mp3",
      "text": "我會完美地講完這節課。",
      "animation": "idle"
    },
    {
      "id": "voice_52",
      "category": "開始戰鬥I",
      "audio": "voices/voice_52.mp3",
      "text": "這、這就要出戰了嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_53",
      "category": "開始戰鬥II",
      "audio": "voices/voice_53.mp3",
      "text": "這也是一門課程吧。",
      "animation": "idle"
    },
    {
      "id": "voice_54",
      "category": "開始戰鬥II",
      "audio": "voices/voice_54.mp3",
      "text": "我會成為……努力的好學生。",
      "animation": "idle"
    },
    {
      "id": "voice_55",
      "category": "開始戰鬥III",
      "audio": "voices/voice_55.mp3",
      "text": "我會好好教導的。",
      "animation": "idle"
    },
    {
      "id": "voice_56",
      "category": "開始戰鬥III",
      "audio": "voices/voice_56.mp3",
      "text": "請您教我。",
      "animation": "idle"
    },
    {
      "id": "voice_57",
      "category": "換彈I",
      "audio": "voices/voice_57.mp3",
      "text": "準備重新換彈。",
      "animation": "idle"
    },
    {
      "id": "voice_58",
      "category": "換彈I",
      "audio": "voices/voice_58.mp3",
      "text": "正在重新裝彈。",
      "animation": "idle"
    },
    {
      "id": "voice_59",
      "category": "換彈II",
      "audio": "voices/voice_59.mp3",
      "text": "馬上就能整頓好。",
      "animation": "idle"
    },
    {
      "id": "voice_60",
      "category": "換彈II",
      "audio": "voices/voice_60.mp3",
      "text": "是這樣做嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_61",
      "category": "換彈III",
      "audio": "voices/voice_61.mp3",
      "text": "能稍等片刻嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_62",
      "category": "換彈III",
      "audio": "voices/voice_62.mp3",
      "text": "裙子有點礙事呢。",
      "animation": "idle"
    },
    {
      "id": "voice_63",
      "category": "可使用爆裂技能",
      "audio": "voices/voice_63.mp3",
      "text": "課程準備完畢。",
      "animation": "idle"
    },
    {
      "id": "voice_64",
      "category": "可使用爆裂技能",
      "audio": "voices/voice_64.mp3",
      "text": "我準備好了，老師。",
      "animation": "idle"
    },
    {
      "id": "voice_65",
      "category": "爆裂技能",
      "audio": "voices/voice_65.mp3",
      "text": "那麼，正式開始上課吧。",
      "animation": "idle"
    },
    {
      "id": "voice_66",
      "category": "爆裂技能",
      "audio": "voices/voice_66.mp3",
      "text": "今天您要教我什麼呢……老師？",
      "animation": "idle"
    },
    {
      "id": "voice_67",
      "category": "全爆裂",
      "audio": "voices/voice_67.mp3",
      "text": "請大家集中注意力聽課！",
      "animation": "idle"
    },
    {
      "id": "voice_68",
      "category": "全爆裂",
      "audio": "voices/voice_68.mp3",
      "text": "快解決吧！",
      "animation": "idle"
    },
    {
      "id": "voice_69",
      "category": "消滅敵人I",
      "audio": "voices/voice_69.mp3",
      "text": "已經處理好了。",
      "animation": "idle"
    },
    {
      "id": "voice_70",
      "category": "消滅敵人I",
      "audio": "voices/voice_70.mp3",
      "text": "呵。",
      "animation": "idle"
    },
    {
      "id": "voice_71",
      "category": "消滅敵人II",
      "audio": "voices/voice_71.mp3",
      "text": "辛苦了。",
      "animation": "idle"
    },
    {
      "id": "voice_72",
      "category": "消滅敵人II",
      "audio": "voices/voice_72.mp3",
      "text": "處理好了。",
      "animation": "idle"
    },
    {
      "id": "voice_73",
      "category": "消滅敵人III",
      "audio": "voices/voice_73.mp3",
      "text": "下課。",
      "animation": "idle"
    },
    {
      "id": "voice_74",
      "category": "消滅敵人III",
      "audio": "voices/voice_74.mp3",
      "text": "結束了。",
      "animation": "idle"
    },
    {
      "id": "voice_75",
      "category": "被擊I",
      "audio": "voices/voice_75.mp3",
      "text": "呃……",
      "animation": "idle"
    },
    {
      "id": "voice_76",
      "category": "被擊I",
      "audio": "voices/voice_76.mp3",
      "text": "呃。",
      "animation": "idle"
    },
    {
      "id": "voice_77",
      "category": "被擊II",
      "audio": "voices/voice_77.mp3",
      "text": "我沒事……",
      "animation": "idle"
    },
    {
      "id": "voice_78",
      "category": "被擊II",
      "audio": "voices/voice_78.mp3",
      "text": "咳！",
      "animation": "idle"
    },
    {
      "id": "voice_79",
      "category": "被擊III",
      "audio": "voices/voice_79.mp3",
      "text": "嗚……！",
      "animation": "idle"
    },
    {
      "id": "voice_80",
      "category": "被擊III",
      "audio": "voices/voice_80.mp3",
      "text": "該死……！",
      "animation": "idle"
    },
    {
      "id": "voice_81",
      "category": "無法戰鬥",
      "audio": "voices/voice_81.mp3",
      "text": "抱歉……接下來就拜託您了。",
      "animation": "idle"
    },
    {
      "id": "voice_82",
      "category": "無法戰鬥",
      "audio": "voices/voice_82.mp3",
      "text": "讓您失望了，對不起……",
      "animation": "idle"
    },
    {
      "id": "voice_83",
      "category": "戰鬥勝利",
      "audio": "voices/voice_83.mp3",
      "text": "接下來該準備下一節課了。",
      "animation": "idle"
    },
    {
      "id": "voice_84",
      "category": "戰鬥勝利",
      "audio": "voices/voice_84.mp3",
      "text": "現在可以回教室了……老師。",
      "animation": "idle"
    }
  ]
}