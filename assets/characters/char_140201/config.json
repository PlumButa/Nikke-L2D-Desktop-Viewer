{
  "id": "140201",
  "resourceId": 402,
  "name": "坎西",
  "skin": "預設",
  "spineVersion": "4.0",
  "skel": "c402_00.skel",
  "atlas": "c402_00.atlas",
  "defaultAnimation": "idle",
  "interactions": [
    {
      "id": "voice_01",
      "category": "在大廳點擊時I",
      "audio": "voices/voice_01.mp3",
      "text": "教官！你好～",
      "animation": "action"
    },
    {
      "id": "voice_02",
      "category": "在大廳點擊時II",
      "audio": "voices/voice_02.mp3",
      "text": "嘻嘻，今天要去哪裡呢～",
      "animation": "action"
    },
    {
      "id": "voice_03",
      "category": "在大廳點擊時III",
      "audio": "voices/voice_03.mp3",
      "text": "今天是諮詢的日子嗎？我忘了啊～",
      "animation": "action"
    },
    {
      "id": "voice_04",
      "category": "在大廳點擊時（好感度10）I",
      "audio": "voices/voice_04.mp3",
      "text": "教官～你會常來探望我吧～？",
      "animation": "action"
    },
    {
      "id": "voice_05",
      "category": "在大廳點擊時（好感度10）II",
      "audio": "voices/voice_05.mp3",
      "text": "改過自新好像也不錯。\n只要教官你在我身邊的話！",
      "animation": "action"
    },
    {
      "id": "voice_06",
      "category": "在大廳點擊時（好感度10）III",
      "audio": "voices/voice_06.mp3",
      "text": "去方舟約會……嗯，我倒是想體驗一下～",
      "animation": "action"
    },
    {
      "id": "voice_07",
      "category": "在大廳閒置時",
      "audio": "voices/voice_07.mp3",
      "text": "教官，你再不來我就先走囉？",
      "animation": "action"
    },
    {
      "id": "voice_08",
      "category": "在大廳閒置時（好感度10）I",
      "audio": "voices/voice_08.mp3",
      "text": "教官！你在哪裡～快來。\n該和我一起去進行交易了！",
      "animation": "shy"
    },
    {
      "id": "voice_09",
      "category": "在前哨基地點擊I",
      "audio": "voices/voice_09.mp3",
      "text": "法院裡太悶了～",
      "animation": "action"
    },
    {
      "id": "voice_10",
      "category": "在前哨基地點擊II",
      "audio": "voices/voice_10.mp3",
      "text": "哪裡可以弄到瓶蓋？法院裡沒有啊～",
      "animation": "action"
    },
    {
      "id": "voice_11",
      "category": "在前哨基地點擊III",
      "audio": "voices/voice_11.mp3",
      "text": "來抓我啊～",
      "animation": "action"
    },
    {
      "id": "voice_12",
      "category": "初次見面",
      "audio": "voices/voice_12.mp3",
      "text": "重刑犯？咦～太過分了～\n你覺得我是那種人嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_13",
      "category": "戰鬥力提升I",
      "audio": "voices/voice_13.mp3",
      "text": "今天的越獄路線我記得特別清楚！",
      "animation": "idle"
    },
    {
      "id": "voice_14",
      "category": "戰鬥力提升II",
      "audio": "voices/voice_14.mp3",
      "text": "哇啊！我會努力越獄的！",
      "animation": "idle"
    },
    {
      "id": "voice_15",
      "category": "戰鬥力提升III",
      "audio": "voices/voice_15.mp3",
      "text": "我在更生館的地位肯定會更加穩固！",
      "animation": "idle"
    },
    {
      "id": "voice_16",
      "category": "禮物I",
      "audio": "voices/voice_16.mp3",
      "text": "這是什麼？難道……是給我的禮物～？謝謝你，教官～",
      "animation": "idle"
    },
    {
      "id": "voice_17",
      "category": "禮物II",
      "audio": "voices/voice_17.mp3",
      "text": "嘻嘻！如果是瓶蓋就好了！",
      "animation": "idle"
    },
    {
      "id": "voice_18",
      "category": "禮物III",
      "audio": "voices/voice_18.mp3",
      "text": "謝謝你～我很喜歡～",
      "animation": "idle"
    },
    {
      "id": "voice_19",
      "category": "好感度提升I",
      "audio": "voices/voice_19.mp3",
      "text": "這是我的瓶蓋。\n如果是教官的話，我可以放心地交給你。",
      "animation": "shy"
    },
    {
      "id": "voice_20",
      "category": "好感度提升II",
      "audio": "voices/voice_20.mp3",
      "text": "今天的教官，很讓我滿意呢！",
      "animation": "shy"
    },
    {
      "id": "voice_21",
      "category": "好感度提升III",
      "audio": "voices/voice_21.mp3",
      "text": "最近我越來越期待諮詢時間了，怎麼會這樣呢～？",
      "animation": "shy"
    },
    {
      "id": "voice_22",
      "category": "編隊",
      "audio": "voices/voice_22.mp3",
      "text": "我可能會逃跑哦，你不怕嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_23",
      "category": "在野外點擊部隊",
      "audio": "voices/voice_23.mp3",
      "text": "怎麼了～？有什麼事嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_24",
      "category": "在野外移動部隊",
      "audio": "voices/voice_24.mp3",
      "text": "要去找新的祕密通道嗎～？",
      "animation": "idle"
    },
    {
      "id": "voice_25",
      "category": "進入戰鬥",
      "audio": "voices/voice_25.mp3",
      "text": "戰鬥開～始！",
      "animation": "idle"
    },
    {
      "id": "voice_26",
      "category": "開始戰鬥I",
      "audio": "voices/voice_26.mp3",
      "text": "結束之後我能拿一些零件走嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_27",
      "category": "開始戰鬥II",
      "audio": "voices/voice_27.mp3",
      "text": "這裡沒有瓶蓋嗎～",
      "animation": "idle"
    },
    {
      "id": "voice_28",
      "category": "開始戰鬥III",
      "audio": "voices/voice_28.mp3",
      "text": "速戰速決吧！",
      "animation": "idle"
    },
    {
      "id": "voice_29",
      "category": "換彈I",
      "audio": "voices/voice_29.mp3",
      "text": "換彈～",
      "animation": "idle"
    },
    {
      "id": "voice_30",
      "category": "換彈II",
      "audio": "voices/voice_30.mp3",
      "text": "要是小看這個手銬，後果可是很嚴重的！",
      "animation": "idle"
    },
    {
      "id": "voice_31",
      "category": "換彈III",
      "audio": "voices/voice_31.mp3",
      "text": "正在裝彈～",
      "animation": "idle"
    },
    {
      "id": "voice_32",
      "category": "可使用爆裂技能",
      "audio": "voices/voice_32.mp3",
      "text": "我打造了新的通道！",
      "animation": "idle"
    },
    {
      "id": "voice_33",
      "category": "爆裂技能",
      "audio": "voices/voice_33.mp3",
      "text": "終於逃脫了！",
      "animation": "idle"
    },
    {
      "id": "voice_34",
      "category": "全爆裂",
      "audio": "voices/voice_34.mp3",
      "text": "好，那就來試試吧～",
      "animation": "idle"
    },
    {
      "id": "voice_35",
      "category": "消滅敵人I",
      "audio": "voices/voice_35.mp3",
      "text": "教官，你看到了嗎？！",
      "animation": "idle"
    },
    {
      "id": "voice_36",
      "category": "消滅敵人II",
      "audio": "voices/voice_36.mp3",
      "text": "有沒有什麼好東西呢～",
      "animation": "idle"
    },
    {
      "id": "voice_37",
      "category": "消滅敵人III",
      "audio": "voices/voice_37.mp3",
      "text": "搞定囉！",
      "animation": "idle"
    },
    {
      "id": "voice_38",
      "category": "被擊I",
      "audio": "voices/voice_38.mp3",
      "text": "啊！",
      "animation": "idle"
    },
    {
      "id": "voice_39",
      "category": "被擊II",
      "audio": "voices/voice_39.mp3",
      "text": "嘿！",
      "animation": "idle"
    },
    {
      "id": "voice_40",
      "category": "被擊III",
      "audio": "voices/voice_40.mp3",
      "text": "呃呃。",
      "animation": "idle"
    },
    {
      "id": "voice_41",
      "category": "無法戰鬥",
      "audio": "voices/voice_41.mp3",
      "text": "果然……逃走才是最簡單的……",
      "animation": "idle"
    },
    {
      "id": "voice_42",
      "category": "戰鬥勝利",
      "audio": "voices/voice_42.mp3",
      "text": "這裡也得鑽一條逃跑通道才行！",
      "animation": "idle"
    }
  ]
}