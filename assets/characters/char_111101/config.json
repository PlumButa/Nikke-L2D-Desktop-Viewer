{
  "id": "111101",
  "resourceId": 111,
  "name": "豺狼",
  "skin": "預設",
  "spineVersion": "4.0",
  "skel": "c111_00.skel",
  "atlas": "c111_00.atlas",
  "defaultAnimation": "idle",
  "interactions": [
    {
      "id": "voice_01",
      "category": "在大廳點擊時I",
      "audio": "voices/voice_01.mp3",
      "text": "嘿嘿嘿！嘿嘿咳咳咳咳咳咳！",
      "animation": "action"
    },
    {
      "id": "voice_02",
      "category": "在大廳點擊時II",
      "audio": "voices/voice_02.mp3",
      "text": "隊長說我像狗！\n這是稱讚，對吧！",
      "animation": "action"
    },
    {
      "id": "voice_03",
      "category": "在大廳點擊時III",
      "audio": "voices/voice_03.mp3",
      "text": "吃了好多飯，開了好多槍，\n今天好幸福。",
      "animation": "action"
    },
    {
      "id": "voice_04",
      "category": "在大廳點擊時（好感度10）I",
      "audio": "voices/voice_04.mp3",
      "text": "告訴我你不喜歡誰！\n我去幫你把他咬碎！",
      "animation": "action"
    },
    {
      "id": "voice_05",
      "category": "在大廳點擊時（好感度10）II",
      "audio": "voices/voice_05.mp3",
      "text": "嘿嘿嘿！\n和指揮官在一起好開心！",
      "animation": "action"
    },
    {
      "id": "voice_06",
      "category": "在大廳點擊時（好感度10）III",
      "audio": "voices/voice_06.mp3",
      "text": "像家裡的守門犬一樣等待指揮官！\n我做得很好吧——！",
      "animation": "action"
    },
    {
      "id": "voice_07",
      "category": "在大廳閒置時",
      "audio": "voices/voice_07.mp3",
      "text": "指揮官……你怎麼什麼都不做？\n我好無聊——",
      "animation": "action"
    },
    {
      "id": "voice_08",
      "category": "在大廳閒置時（好感度10）I",
      "audio": "voices/voice_08.mp3",
      "text": "指揮官，一起玩嘛——\n嘿嘿，你總是不陪我玩，我可能會咬人哦？",
      "animation": "shy_02"
    },
    {
      "id": "voice_09",
      "category": "在前哨基地點擊I",
      "audio": "voices/voice_09.mp3",
      "text": "隊長說石傷吧？時尚吧？\n總之她要我帶你去那裡！",
      "animation": "action"
    },
    {
      "id": "voice_10",
      "category": "在前哨基地點擊II",
      "audio": "voices/voice_10.mp3",
      "text": "這裡好棒！有這麼多好吃的好玩的！\n我可以一直待在這裡嗎？",
      "animation": "action"
    },
    {
      "id": "voice_11",
      "category": "在前哨基地點擊III",
      "audio": "voices/voice_11.mp3",
      "text": "在這裡開槍玩應該很有趣！\n突突突——突突突突突！嘿嘿嘿！",
      "animation": "action"
    },
    {
      "id": "voice_12",
      "category": "初次見面",
      "audio": "voices/voice_12.mp3",
      "text": "嘿嘿嘿！我可以像狗一樣咬人嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_13",
      "category": "戰鬥力提升I",
      "audio": "voices/voice_13.mp3",
      "text": "我變強啦！",
      "animation": "idle"
    },
    {
      "id": "voice_14",
      "category": "戰鬥力提升II",
      "audio": "voices/voice_14.mp3",
      "text": "你看！我的牙齒更結實了！",
      "animation": "idle"
    },
    {
      "id": "voice_15",
      "category": "戰鬥力提升III",
      "audio": "voices/voice_15.mp3",
      "text": "我現在可以咬人了嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_16",
      "category": "禮物I",
      "audio": "voices/voice_16.mp3",
      "text": "這是送我的？真的嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_17",
      "category": "禮物II",
      "audio": "voices/voice_17.mp3",
      "text": "指揮官，你真是個好人！",
      "animation": "idle"
    },
    {
      "id": "voice_18",
      "category": "禮物III",
      "audio": "voices/voice_18.mp3",
      "text": "這些都是我的！好幸福——！",
      "animation": "idle"
    },
    {
      "id": "voice_19",
      "category": "好感度提升I",
      "audio": "voices/voice_19.mp3",
      "text": "我喜歡指揮官！\n要是沒有隊長，我會把指揮官當作主人！",
      "animation": "shy_02"
    },
    {
      "id": "voice_20",
      "category": "好感度提升II",
      "audio": "voices/voice_20.mp3",
      "text": "沒有指揮官會很無聊。\n希望指揮官繼續陪我一起玩！",
      "animation": "shy_02"
    },
    {
      "id": "voice_21",
      "category": "好感度提升III",
      "audio": "voices/voice_21.mp3",
      "text": "嘿嘿嘿！我會去咬任何人，但是不會咬指揮官！\n我保證！",
      "animation": "shy_02"
    },
    {
      "id": "voice_22",
      "category": "編隊",
      "audio": "voices/voice_22.mp3",
      "text": "我們要去玩嗎？去哪裡？",
      "animation": "idle"
    },
    {
      "id": "voice_23",
      "category": "在野外點擊部隊",
      "audio": "voices/voice_23.mp3",
      "text": "你叫我了嗎？",
      "animation": "idle"
    },
    {
      "id": "voice_24",
      "category": "在野外移動部隊",
      "audio": "voices/voice_24.mp3",
      "text": "我去那邊——！",
      "animation": "idle"
    },
    {
      "id": "voice_25",
      "category": "進入戰鬥",
      "audio": "voices/voice_25.mp3",
      "text": "有趣的事情來啦！",
      "animation": "idle"
    },
    {
      "id": "voice_26",
      "category": "開始戰鬥I",
      "audio": "voices/voice_26.mp3",
      "text": "要把它們全部咬成碎片，對吧？",
      "animation": "idle"
    },
    {
      "id": "voice_27",
      "category": "開始戰鬥II",
      "audio": "voices/voice_27.mp3",
      "text": "嘿嘿嘿！來啦……來啦！",
      "animation": "idle"
    },
    {
      "id": "voice_28",
      "category": "開始戰鬥III",
      "audio": "voices/voice_28.mp3",
      "text": "把這些全都殺光，指揮官就會誇獎我吧？",
      "animation": "idle"
    },
    {
      "id": "voice_29",
      "category": "換彈I",
      "audio": "voices/voice_29.mp3",
      "text": "嘿嘿嘿！真有趣——！",
      "animation": "idle"
    },
    {
      "id": "voice_30",
      "category": "換彈II",
      "audio": "voices/voice_30.mp3",
      "text": "要快點換完彈再次戰鬥！",
      "animation": "idle"
    },
    {
      "id": "voice_31",
      "category": "換彈III",
      "audio": "voices/voice_31.mp3",
      "text": "好緊張！真開心↗！",
      "animation": "idle"
    },
    {
      "id": "voice_32",
      "category": "可使用爆裂技能",
      "audio": "voices/voice_32.mp3",
      "text": "指揮官——！",
      "animation": "idle"
    },
    {
      "id": "voice_33",
      "category": "爆裂技能",
      "audio": "voices/voice_33.mp3",
      "text": "我要把它們撕咬成碎片！嘿嘿嘿！",
      "animation": "idle"
    },
    {
      "id": "voice_34",
      "category": "全爆裂",
      "audio": "voices/voice_34.mp3",
      "text": "嘿嘿嘿！都射中吧——！",
      "animation": "idle"
    },
    {
      "id": "voice_35",
      "category": "消滅敵人I",
      "audio": "voices/voice_35.mp3",
      "text": "解決了！",
      "animation": "idle"
    },
    {
      "id": "voice_36",
      "category": "消滅敵人II",
      "audio": "voices/voice_36.mp3",
      "text": "殺完啦！",
      "animation": "idle"
    },
    {
      "id": "voice_37",
      "category": "消滅敵人III",
      "audio": "voices/voice_37.mp3",
      "text": "嘿嘿嘿嘿！",
      "animation": "idle"
    },
    {
      "id": "voice_38",
      "category": "被擊I",
      "audio": "voices/voice_38.mp3",
      "text": "咳！",
      "animation": "idle"
    },
    {
      "id": "voice_39",
      "category": "被擊II",
      "audio": "voices/voice_39.mp3",
      "text": "嗷嗷！",
      "animation": "idle"
    },
    {
      "id": "voice_40",
      "category": "被擊III",
      "audio": "voices/voice_40.mp3",
      "text": "啊！",
      "animation": "idle"
    },
    {
      "id": "voice_41",
      "category": "無法戰鬥",
      "audio": "voices/voice_41.mp3",
      "text": "咳咳……呃，我好累，不打了。",
      "animation": "idle"
    },
    {
      "id": "voice_42",
      "category": "戰鬥勝利",
      "audio": "voices/voice_42.mp3",
      "text": "指揮官我贏啦！我做得好吧！",
      "animation": "idle"
    }
  ]
}