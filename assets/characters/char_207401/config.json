{
  "id": "207401",
  "resourceId": 74,
  "name": "索林：霜雪車票",
  "skin": "預設",
  "spineVersion": "4.0",
  "skel": "c074_00.skel",
  "atlas": "c074_00.atlas",
  "defaultAnimation": "idle",
  "interactions": [
    {
      "id": "voice_01",
      "category": "在大廳點擊時I",
      "audio": "voices/voice_01.mp3",
      "text": "怎麼樣？這套衣服很漂亮吧！\n你不覺得我變成熟了嗎？",
      "animation": "action"
    },
    {
      "id": "voice_02",
      "category": "在大廳點擊時II",
      "audio": "voices/voice_02.mp3",
      "text": "好想趕快到地面喔～\n想讓你看看\n我穿上這套衣服活躍的模樣。",
      "animation": "action"
    },
    {
      "id": "voice_03",
      "category": "在大廳點擊時III",
      "audio": "voices/voice_03.mp3",
      "text": "指揮官，你要搭AZX嗎？\n我現在是個很～稱職的乘務員喔！",
      "animation": "action"
    },
    {
      "id": "voice_04",
      "category": "在大廳點擊時（好感度10）I",
      "audio": "voices/voice_04.mp3",
      "text": "哼哼～\n換上漂亮的衣服，變得更成熟了，\n所以苦咖啡我現在一定也喝得下去！",
      "animation": "action"
    },
    {
      "id": "voice_05",
      "category": "在大廳點擊時（好感度10）II",
      "audio": "voices/voice_05.mp3",
      "text": "儘管告訴我你想去哪，\n任何地方我都帶你去！",
      "animation": "action"
    },
    {
      "id": "voice_06",
      "category": "在大廳點擊時（好感度10）III",
      "audio": "voices/voice_06.mp3",
      "text": "如果哪天……\nAZX可以去地面上的任何地方，\n指揮官要不要跟我一起去旅行？",
      "animation": "action"
    },
    {
      "id": "voice_07",
      "category": "在大廳閒置時",
      "audio": "voices/voice_07.mp3",
      "text": "呿……我都特地來了，你居然不在？\n真的很難過耶……",
      "animation": "action"
    },
    {
      "id": "voice_08",
      "category": "在大廳閒置時（好感度10）I",
      "audio": "voices/voice_08.mp3",
      "text": "哼，我現在是大人，可以獨立了。\n一想到跟指揮官一起去旅行的地方，\n時間就過得很快。",
      "animation": "delight"
    },
    {
      "id": "voice_09",
      "category": "在前哨基地點擊I",
      "audio": "voices/voice_09.mp3",
      "text": "哼哼～穿上這麼漂亮的衣服，\n我得去跟前哨基地的大家\n好好炫耀一番～",
      "animation": "action"
    },
    {
      "id": "voice_10",
      "category": "在前哨基地點擊II",
      "audio": "voices/voice_10.mp3",
      "text": "我打算幫AZX也換上漂亮的衣服，\n指揮官要一起去嗎？",
      "animation": "action"
    },
    {
      "id": "voice_11",
      "category": "在前哨基地點擊III",
      "audio": "voices/voice_11.mp3",
      "text": "嘿嘿，既然都來前哨基地了，\n當然要去火車站買一堆好吃的，\n再開心玩個夠～",
      "animation": "action"
    },
    {
      "id": "voice_12",
      "category": "初次見面",
      "audio": "voices/voice_12.mp3",
      "text": "指揮官～怎麼樣？漂亮吧！\n既然穿了新衣服，\n這次就好好展現大人的樣子給你看！",
      "animation": "idle"
    },
    {
      "id": "voice_13",
      "category": "戰鬥力提升I",
      "audio": "voices/voice_13.mp3",
      "text": "哼哼～我又成長了～",
      "animation": "idle"
    },
    {
      "id": "voice_14",
      "category": "戰鬥力提升II",
      "audio": "voices/voice_14.mp3",
      "text": "怎麼樣？我是不是長高一點了？",
      "animation": "idle"
    },
    {
      "id": "voice_15",
      "category": "戰鬥力提升III",
      "audio": "voices/voice_15.mp3",
      "text": "我好像變得更像大人了！",
      "animation": "idle"
    },
    {
      "id": "voice_16",
      "category": "禮物I",
      "audio": "voices/voice_16.mp3",
      "text": "欸欸……！我也要送禮物給你！\n下次輪到指揮官收禮物！",
      "animation": "idle"
    },
    {
      "id": "voice_17",
      "category": "禮物II",
      "audio": "voices/voice_17.mp3",
      "text": "哇……我超想要這個的……！\n指揮官，謝謝你！",
      "animation": "idle"
    },
    {
      "id": "voice_18",
      "category": "禮物III",
      "audio": "voices/voice_18.mp3",
      "text": "我、我又不是小孩……\n才不會因為這種東西就覺得高興……\n但既然是指揮官準備的，\n我、我就高興一下吧！",
      "animation": "idle"
    },
    {
      "id": "voice_19",
      "category": "好感度提升I",
      "audio": "voices/voice_19.mp3",
      "text": "如果能天天跟指揮官在一起就好了。\n這樣就能每天一起坐AZX到處玩了呢。",
      "animation": "delight"
    },
    {
      "id": "voice_20",
      "category": "好感度提升II",
      "audio": "voices/voice_20.mp3",
      "text": "哼哼～看在我心情好的份上，\n就特別把指揮官當VIP乘客來服務吧！",
      "animation": "delight"
    },
    {
      "id": "voice_21",
      "category": "好感度提升III",
      "audio": "voices/voice_21.mp3",
      "text": "好奇怪……\n我只要換了漂亮衣服，\n就會最想先給指揮官看。",
      "animation": "delight"
    },
    {
      "id": "voice_22",
      "category": "編隊",
      "audio": "voices/voice_22.mp3",
      "text": "果然還是需要我，對吧？\n我就陪你一起去吧。",
      "animation": "idle"
    },
    {
      "id": "voice_23",
      "category": "在野外點擊部隊",
      "audio": "voices/voice_23.mp3",
      "text": "要、要去哪？",
      "animation": "idle"
    },
    {
      "id": "voice_24",
      "category": "在野外移動部隊",
      "audio": "voices/voice_24.mp3",
      "text": "上吧，AZX！",
      "animation": "idle"
    },
    {
      "id": "voice_25",
      "category": "進入戰鬥",
      "audio": "voices/voice_25.mp3",
      "text": "呃啊啊！！要撞到了！",
      "animation": "idle"
    },
    {
      "id": "voice_26",
      "category": "開始戰鬥I",
      "audio": "voices/voice_26.mp3",
      "text": "我真的成長很多，看好了！",
      "animation": "idle"
    },
    {
      "id": "voice_27",
      "category": "開始戰鬥II",
      "audio": "voices/voice_27.mp3",
      "text": "現、現在遇到這種事……我完全不會緊張！",
      "animation": "idle"
    },
    {
      "id": "voice_28",
      "category": "開始戰鬥III",
      "audio": "voices/voice_28.mp3",
      "text": "我會像大人一樣解決一切！",
      "animation": "idle"
    },
    {
      "id": "voice_29",
      "category": "換彈I",
      "audio": "voices/voice_29.mp3",
      "text": "唉……事情沒有我想得順利。",
      "animation": "idle"
    },
    {
      "id": "voice_30",
      "category": "換彈II",
      "audio": "voices/voice_30.mp3",
      "text": "休息一下，馬上出發！",
      "animation": "idle"
    },
    {
      "id": "voice_31",
      "category": "換彈III",
      "audio": "voices/voice_31.mp3",
      "text": "呃呃……等等我……！我立刻跟上！",
      "animation": "idle"
    },
    {
      "id": "voice_32",
      "category": "可使用爆裂技能",
      "audio": "voices/voice_32.mp3",
      "text": "換我了！",
      "animation": "idle"
    },
    {
      "id": "voice_33",
      "category": "爆裂技能",
      "audio": "voices/voice_33.mp3",
      "text": "承載幸福的AZX，帶你去任何地方！",
      "animation": "idle"
    },
    {
      "id": "voice_34",
      "category": "全爆裂",
      "audio": "voices/voice_34.mp3",
      "text": "就是現在！大家快衝啊！",
      "animation": "idle"
    },
    {
      "id": "voice_35",
      "category": "消滅敵人I",
      "audio": "voices/voice_35.mp3",
      "text": "成功了！",
      "animation": "idle"
    },
    {
      "id": "voice_36",
      "category": "消滅敵人II",
      "audio": "voices/voice_36.mp3",
      "text": "哼哼～看到了吧？",
      "animation": "idle"
    },
    {
      "id": "voice_37",
      "category": "消滅敵人III",
      "audio": "voices/voice_37.mp3",
      "text": "給我走開！",
      "animation": "idle"
    },
    {
      "id": "voice_38",
      "category": "被擊I",
      "audio": "voices/voice_38.mp3",
      "text": "我的衣服！",
      "animation": "idle"
    },
    {
      "id": "voice_39",
      "category": "被擊II",
      "audio": "voices/voice_39.mp3",
      "text": "好痛！",
      "animation": "idle"
    },
    {
      "id": "voice_40",
      "category": "被擊III",
      "audio": "voices/voice_40.mp3",
      "text": "呃啊……！",
      "animation": "idle"
    },
    {
      "id": "voice_41",
      "category": "無法戰鬥",
      "audio": "voices/voice_41.mp3",
      "text": "嗚……衣服也都弄壞了……什麼忙都沒幫上……\n對不起，指揮官。",
      "animation": "idle"
    },
    {
      "id": "voice_42",
      "category": "戰鬥勝利",
      "audio": "voices/voice_42.mp3",
      "text": "哼哼～看吧，我就說我成長了！\n這樣子算是幫到忙了對不對？",
      "animation": "idle"
    }
  ]
}